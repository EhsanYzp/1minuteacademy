  "is_free": true,
  "published": true,
  "story": {
    "hook": {
      "text": "Some brains process the world differently from birth—intense focus, unique perception, but social rules feel foreign.",
      "visual": "🧩"
    },
    "buildup": {
      "text": "Autism spectrum disorder involves differences in social communication, sensory processing, and behavior patterns.",
      "visual": "📡"
    },
    "discovery": {
      "text": "Brain imaging shows altered connectivity—some networks are overconnected, others underconnected.",
      "visual": "🔗"
    },
    "twist": {
      "text": "Autism isn't a single condition—it's a spectrum ranging from high support needs to people you'd never notice.",
      "visual": "🌈"
    },
    "climax": {
      "text": "Many autistic individuals excel in pattern recognition, memory, and systematic thinking—traits valued in tech and science.",
      "visual": "💻"
    },
    "punchline": {
      "text": "Autism is not a broken brain. It's a differently wired one.",
      "visual": "🧠"
    }
  },
  "quiz": {
    "question": "What does brain imaging show in autism?",
    "options": [
      "Altered connectivity patterns between brain networks",
      "A significantly smaller brain",
      "Complete absence of neurotransmitters"
    ],
    "correct": 0
  },
