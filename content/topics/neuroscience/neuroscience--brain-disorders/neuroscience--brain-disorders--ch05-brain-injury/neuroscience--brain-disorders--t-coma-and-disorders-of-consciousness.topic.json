  "story": {
    "hook": {
      "text": "A patient lies still, eyes closed, unresponsive. But brain scans reveal a startling secret: awareness may remain.",
      "visual": "🛏️"
    },
    "buildup": {
      "text": "Coma is a state of prolonged unconsciousness caused by severe brain injury or metabolic failure.",
      "visual": "😶"
    },
    "discovery": {
      "text": "Some patients in a vegetative state show brain activity when asked to imagine playing tennis—hidden consciousness.",
      "visual": "🎾"
    },
    "twist": {
      "text": "Researchers estimate 15-20% of vegetative patients may actually be consciously aware but unable to respond.",
      "visual": "😱"
    },
    "climax": {
      "text": "Brain-computer interfaces may someday allow these locked-in patients to communicate their thoughts and wishes.",
      "visual": "💻"
    },
    "punchline": {
      "text": "Silence doesn't always mean absence. Some minds are trapped, not gone.",
      "visual": "🔒"
    }
  },
  "quiz": {
    "question": "What percentage of vegetative patients may have hidden consciousness?",
    "options": [
      "15-20%",
      "Less than 1%",
      "Over 90%"
    ],
    "correct": 0
  },
