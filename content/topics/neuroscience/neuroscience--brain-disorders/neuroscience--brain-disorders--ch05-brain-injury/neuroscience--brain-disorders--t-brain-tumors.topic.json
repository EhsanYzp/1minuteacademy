  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "A persistent headache, personality changes, and sudden seizures—a mass is growing where it shouldn't be.",
      "visual": "🔍"
    },
    "buildup": {
      "text": "Brain tumors are abnormal cell growths inside the skull that compress or invade healthy brain tissue.",
      "visual": "📈"
    },
    "discovery": {
      "text": "Benign tumors don't spread but can still be deadly by pressing on critical structures in the confined skull.",
      "visual": "💀"
    },
    "twist": {
      "text": "The blood-brain barrier that protects the brain also blocks most chemotherapy drugs from reaching tumors.",
      "visual": "🧱"
    },
    "climax": {
      "text": "Surgeons now operate on awake patients, asking them to talk or move while removing tumor near critical areas.",
      "visual": "🗣️"
    },
    "punchline": {
      "text": "Brain surgery while awake sounds terrifying.",
      "visual": "🔬"
    }
  },
  "quiz": {
    "question": "Why are some brain surgeries performed on awake patients?",
    "options": [
      "To monitor brain function and avoid damaging critical areas",
      "Because anesthesia doesn't work on brain tumors",
      "To reduce surgery costs"
    ],
    "correct": 0
  },
