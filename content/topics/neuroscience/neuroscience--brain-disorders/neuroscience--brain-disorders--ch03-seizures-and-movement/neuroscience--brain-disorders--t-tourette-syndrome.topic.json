  "story": {
    "hook": {
      "text": "A child blinks rapidly, clears their throat, and shouts an unexpected word. They can't stop. This is Tourette's.",
      "visual": "😣"
    },
    "buildup": {
      "text": "Tourette syndrome involves involuntary movements (motor tics) and sounds (vocal tics) that wax and wane.",
      "visual": "🔄"
    },
    "discovery": {
      "text": "The basal ganglia's ability to suppress unwanted movements is impaired—signals that should be inhibited leak through.",
      "visual": "🚰"
    },
    "twist": {
      "text": "Only about 10% of Tourette's patients have coprolalia—involuntary swearing. Media vastly overrepresents this symptom.",
      "visual": "📺"
    },
    "climax": {
      "text": "Many people with Tourette's report a premonitory urge before tics—like an itch that only the tic can scratch.",
      "visual": "🤏"
    },
    "punchline": {
      "text": "Tourette's isn't about swearing. It's about a brain can't fully filter its own impulses.",
      "visual": "🧠"
    }
  },
  "quiz": {
    "question": "What percentage of Tourette's patients have coprolalia (involuntary swearing)?",
    "options": [
      "About 10%",
      "Over 90%",
      "About 50%"
    ],
    "correct": 0
  },
