  "is_free": true,
  "published": true,
  "story": {
    "hook": {
      "text": "Without warning, millions of neurons fire simultaneously in a massive electrical storm. A seizure begins.",
      "visual": "⚡"
    },
    "buildup": {
      "text": "Epilepsy is a condition where the brain's normal electrical activity becomes temporarily disrupted and chaotic.",
      "visual": "🌩️"
    },
    "discovery": {
      "text": "Seizures range from brief staring spells (absence seizures) to full convulsions (tonic-clonic seizures).",
      "visual": "😶"
    },
    "twist": {
      "text": "Some patients have seizure-free surgery: removing a small brain area where seizures originate can cure the condition.",
      "visual": "🔪"
    },
    "climax": {
      "text": "About 70% of epilepsy patients can control seizures with medication. The remaining 30% face ongoing challenges.",
      "visual": "💊"
    },
    "punchline": {
      "text": "Epilepsy is electricity misfiring.",
      "visual": "🔇"
    }
  },
  "quiz": {
    "question": "What causes a seizure in epilepsy?",
    "options": [
      "Millions of neurons firing simultaneously and chaotically",
      "A blood clot in the brain",
      "Excess melatonin production"
    ],
    "correct": 0
  },
