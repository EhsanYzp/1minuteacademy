  "story": {
    "hook": {
      "text": "A tiny stutter in DNA repeats three letters far too many times, setting a countdown for brain destruction decades later.",
      "visual": "🔁"
    },
    "buildup": {
      "text": "The HTT gene normally contains about 20 CAG repeats.",
      "visual": "📏"
    },
    "discovery": {
      "text": "The mutant protein slowly poisons neurons in the striatum, triggering involuntary movements, personality changes, and progressive.",
      "visual": "☠️"
    },
    "twist": {
      "text": "Longer repeat expansions cause earlier onset. With 70 repeats, the disease can strike in childhood.",
      "visual": "⏳"
    },
    "climax": {
      "text": "Each new generation can inherit even longer repeats, a phenomenon called anticipation, meaning children may develop symptoms.",
      "visual": "📉"
    },
    "punchline": {
      "text": "Huntington disease is a genetic time bomb.",
      "visual": "💣"
    }
  },
  "quiz": {
    "question": "What determines the age of onset in Huntington disease?",
    "options": [
      "The number of CAG repeats in the HTT gene",
      "The total amount of dopamine in the brain",
      "The size of the hippocampus"
    ],
    "correct": 0
  },
