  "story": {
    "hook": {
      "text": "One week you feel invincible—no sleep needed, ideas racing. The next week you can't get out of bed.",
      "visual": "🎢"
    },
    "buildup": {
      "text": "Bipolar disorder cycles between manic highs and depressive lows, each lasting days to months.",
      "visual": "📊"
    },
    "discovery": {
      "text": "During mania, the prefrontal cortex underperforms while reward circuits go into overdrive.",
      "visual": "🚀"
    },
    "twist": {
      "text": "Many creative geniuses—Van Gogh, Virginia Woolf, Kanye West—have been associated with bipolar disorder.",
      "visual": "🎨"
    },
    "climax": {
      "text": "Lithium, a simple element, stabilizes mood remarkably well—though scientists still don't fully understand why.",
      "visual": "💊"
    },
    "punchline": {
      "text": "Bipolar isn't moodiness. It's a brain that swings between two extremes it cannot control.",
      "visual": "⚖️"
    }
  },
  "quiz": {
    "question": "What medication is commonly used to treat bipolar disorder?",
    "options": [
      "Lithium",
      "Insulin",
      "Aspirin"
    ],
    "correct": 0
  },
