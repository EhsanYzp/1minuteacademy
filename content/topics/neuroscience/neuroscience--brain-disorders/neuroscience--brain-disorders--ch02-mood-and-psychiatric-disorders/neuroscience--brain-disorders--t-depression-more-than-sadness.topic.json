  "is_free": true,
  "published": true,
  "story": {
    "hook": {
      "text": "Depression isn't feeling sad about something. It's feeling nothing about everything—for weeks, months, years.",
      "visual": "⬛"
    },
    "buildup": {
      "text": "Major depression involves persistent low mood, loss of interest, fatigue, and disrupted sleep and appetite.",
      "visual": "😞"
    },
    "discovery": {
      "text": "Brain scans show reduced activity in the prefrontal cortex and excessive activity in the amygdala.",
      "visual": "🧠"
    },
    "twist": {
      "text": "The old serotonin deficit theory is incomplete—depression involves multiple neurotransmitter systems and neural circuits.",
      "visual": "🔀"
    },
    "climax": {
      "text": "Ketamine, an anesthetic, can lift severe depression within hours by promoting rapid synapse growth.",
      "visual": "💊"
    },
    "punchline": {
      "text": "Depression isn't a character flaw. It's a circuit malfunction that medicine can treat.",
      "visual": "🔧"
    }
  },
  "quiz": {
    "question": "What brain changes are seen in major depression?",
    "options": [
      "Reduced prefrontal activity and excessive amygdala activity",
      "Enlarged hippocampus",
      "Overactive cerebellum"
    ],
    "correct": 0
  },
