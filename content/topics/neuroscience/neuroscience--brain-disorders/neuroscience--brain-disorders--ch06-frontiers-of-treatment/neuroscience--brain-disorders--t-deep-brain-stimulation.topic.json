  "story": {
    "hook": {
      "text": "A Parkinson's patient's tremor stops the instant a surgeon flips a switch on an implanted electrode.",
      "visual": "🔘"
    },
    "buildup": {
      "text": "Deep brain stimulation (DBS) implants thin electrodes into specific brain regions and delivers electrical pulses.",
      "visual": "⚡"
    },
    "discovery": {
      "text": "It's FDA-approved for Parkinson's, essential tremor, and dystonia—with trials underway for depression and OCD.",
      "visual": "🩺"
    },
    "twist": {
      "text": "Doctors don't fully understand why DBS works—it may disrupt abnormal circuits rather than stimulate normal ones.",
      "visual": "🤔"
    },
    "climax": {
      "text": "Patients can adjust stimulation intensity with a remote control—fine-tuning their own brain activity.",
      "visual": "🎛️"
    },
    "punchline": {
      "text": "We can now pace the brain like we pace the heart—electrical medicine for neural circuits.",
      "visual": "❤️"
    }
  },
  "quiz": {
    "question": "What conditions is deep brain stimulation FDA-approved for?",
    "options": [
      "Parkinson's, essential tremor, and dystonia",
      "Only Alzheimer's disease",
      "Common headaches"
    ],
    "correct": 0
  },
