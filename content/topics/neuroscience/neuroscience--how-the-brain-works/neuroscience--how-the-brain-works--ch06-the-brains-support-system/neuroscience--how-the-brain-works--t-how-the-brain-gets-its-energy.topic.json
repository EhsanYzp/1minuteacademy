  "title": "How the Brain Gets Its Energy",
  "emoji": "🧠",
  "color": "#7C3AED",
  "description": "Learn How the Brain Gets Its Energy in one minute.",
  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "Your brain is 2% of your body weight but devours 20% of your calories. It's an energy hog.",
      "visual": "🔋"
    },
    "buildup": {
      "text": "Glucose is the brain's primary fuel, delivered by a dense network of blood vessels.",
      "visual": "🩸"
    },
    "discovery": {
      "text": "If blood supply stops for just five minutes, neurons begin to die—causing a stroke.",
      "visual": "🧊"
    },
    "twist": {
      "text": "During starvation, the brain switches to ketone bodies—a backup fuel made from fat.",
      "visual": "🥑"
    },
    "climax": {
      "text": "Intense thinking doesn't burn noticeably more calories—the brain's baseline cost is already enormous.",
      "visual": "📊"
    },
    "punchline": {
      "text": "The brain never rests. Even asleep, it burns energy like a 20-watt bulb.",
      "visual": "💡"
    }
  },
  "quiz": {
    "question": "What is the brain's primary fuel source?",
    "options": [
      "Glucose",
      "Protein",
      "Oxygen alone"
    ],
    "correct": 0
  },
