  "story": {
    "hook": {
      "text": "For decades, scientists thought glial cells were just brain glue. They were spectacularly wrong.",
      "visual": "🔬"
    },
    "buildup": {
      "text": "Glia outnumber neurons and come in several types: astrocytes, oligodendrocytes, and microglia.",
      "visual": "⭐"
    },
    "discovery": {
      "text": "Astrocytes feed neurons, regulate blood flow, and even influence synaptic signaling.",
      "visual": "🍽️"
    },
    "twist": {
      "text": "Microglia are the brain's immune cells—they patrol for damage and eat dead cells.",
      "visual": "🛡️"
    },
    "climax": {
      "text": "Einstein's brain had an unusually high ratio of glia to neurons, sparking research into their role.",
      "visual": "🧑‍🔬"
    },
    "punchline": {
      "text": "Neurons get the fame. Glia do half the work.",
      "visual": "🤝"
    }
  },
  "quiz": {
    "question": "What role do microglia serve in the brain?",
    "options": [
      "They act as the brain's immune cells",
      "They transmit electrical signals",
      "They store memories"
    ],
    "correct": 0
  },
