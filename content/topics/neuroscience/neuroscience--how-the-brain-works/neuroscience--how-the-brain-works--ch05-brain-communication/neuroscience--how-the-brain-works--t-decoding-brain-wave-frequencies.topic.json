  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "Your brain produces measurable electrical oscillations, and each frequency band reveals a different mental state.",
      "visual": "📊"
    },
    "buildup": {
      "text": "Delta waves, the slowest at 0.5 to 4 Hz, dominate during deep dreamless sleep and physical restoration.",
      "visual": "😴"
    },
    "discovery": {
      "text": "Theta waves at 4 to 8 Hz emerge during light sleep and daydreaming, bridging conscious and unconscious thought.",
      "visual": "💭"
    },
    "twist": {
      "text": "Alpha waves at 8 to 13 Hz appear when you close your eyes and relax, marking calm wakefulness.",
      "visual": "🧘"
    },
    "climax": {
      "text": "Beta waves at 13 to 30 Hz signal active thinking, while gamma above 30 Hz links to heightened perception.",
      "visual": "🎯"
    },
    "punchline": {
      "text": "Five frequency bands, five mental states. Your brain broadcasts what it is doing.",
      "visual": "📻"
    }
  },
  "quiz": {
    "question": "Which brain wave frequency range is associated with deep sleep?",
    "options": [
      "Delta waves at 0.5 to 4 Hz",
      "Beta waves at 13 to 30 Hz",
      "Gamma waves above 30 Hz"
    ],
    "correct": 0
  },
