  "story": {
    "hook": {
      "text": "Try catching a ball thrown at you. The split-second coordination? That's your cerebellum.",
      "visual": "🏐"
    },
    "buildup": {
      "text": "It sits at the back of the brain and contains more neurons than the rest of the brain combined.",
      "visual": "🔢"
    },
    "discovery": {
      "text": "The cerebellum fine-tunes motor commands—making movements smooth instead of jerky.",
      "visual": "🎻"
    },
    "twist": {
      "text": "Recent research shows it also contributes to language, attention, and emotional regulation.",
      "visual": "📚"
    },
    "climax": {
      "text": "Alcohol impairs the cerebellum first, which is why drunk people stumble and slur.",
      "visual": "🍺"
    },
    "punchline": {
      "text": "The cerebellum doesn't start movement. It perfects it.",
      "visual": "✨"
    }
  },
  "quiz": {
    "question": "What is the cerebellum's primary role?",
    "options": [
      "Fine-tuning motor coordination",
      "Storing memories",
      "Processing emotions"
    ],
    "correct": 0
  },
