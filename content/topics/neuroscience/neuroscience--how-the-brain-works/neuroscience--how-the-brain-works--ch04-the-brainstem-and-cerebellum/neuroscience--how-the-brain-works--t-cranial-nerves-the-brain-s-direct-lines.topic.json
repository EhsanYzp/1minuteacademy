  "story": {
    "hook": {
      "text": "Smile, blink, taste food, move your eyes—all without involving the spinal cord. Cranial nerves handle it.",
      "visual": "😊"
    },
    "buildup": {
      "text": "Twelve pairs of cranial nerves emerge directly from the brainstem, skipping the spinal highway.",
      "visual": "🛣️"
    },
    "discovery": {
      "text": "They control face muscles, eye movement, hearing, taste, and even your heart rate via the vagus nerve.",
      "visual": "💓"
    },
    "twist": {
      "text": "The vagus nerve is the longest cranial nerve—it wanders from the brainstem all the way to the gut.",
      "visual": "🎢"
    },
    "climax": {
      "text": "Doctors test cranial nerves to check brainstem health: follow my finger, show your teeth, say 'aah'.",
      "visual": "🩺"
    },
    "punchline": {
      "text": "Twelve nerve pairs run the face and organs directly from the brain.",
      "visual": "🔌"
    }
  },
  "quiz": {
    "question": "How many pairs of cranial nerves does the brain have?",
    "options": [
      "12",
      "8",
      "24"
    ],
    "correct": 0
  },
