  "story": {
    "hook": {
      "text": "Stop breathing on purpose. Now wait. Your brainstem forced you to breathe again.",
      "visual": "🫁"
    },
    "buildup": {
      "text": "The brainstem connects the brain to the spinal cord and controls heartbeat, breathing, and blood pressure.",
      "visual": "❤️"
    },
    "discovery": {
      "text": "It works 24/7 without conscious input—an autopilot for your most vital functions.",
      "visual": "✈️"
    },
    "twist": {
      "text": "Brain death is legally defined as irreversible loss of brainstem function, even if the cortex still shows activity.",
      "visual": "📋"
    },
    "climax": {
      "text": "It also manages reflexes like coughing, sneezing, and swallowing—things you never think about.",
      "visual": "🤧"
    },
    "punchline": {
      "text": "You can live without a cortex. You cannot live without a brainstem.",
      "visual": "💀"
    }
  },
  "quiz": {
    "question": "What does the brainstem primarily control?",
    "options": [
      "Vital functions like breathing and heartbeat",
      "Complex reasoning",
      "Long-term memory"
    ],
    "correct": 0
  },
