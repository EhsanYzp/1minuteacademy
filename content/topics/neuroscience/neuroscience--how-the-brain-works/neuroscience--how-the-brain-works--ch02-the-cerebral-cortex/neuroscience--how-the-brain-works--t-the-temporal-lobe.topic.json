  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "You recognize your mother's voice instantly among hundreds. Thank your temporal lobes.",
      "visual": "👂"
    },
    "buildup": {
      "text": "These lobes sit above your ears and process sound, language comprehension, and face recognition.",
      "visual": "🗣️"
    },
    "discovery": {
      "text": "Wernicke's area, in the left temporal lobe, lets you understand spoken and written language.",
      "visual": "📖"
    },
    "twist": {
      "text": "Damage to Wernicke's area produces fluent but nonsensical speech—words flow but meaning vanishes.",
      "visual": "🌀"
    },
    "climax": {
      "text": "The temporal lobe also houses the hippocampus, the gateway to forming new memories.",
      "visual": "🚪"
    },
    "punchline": {
      "text": "Sound, meaning, and memory all pass through your temporal lobes.",
      "visual": "🎵"
    }
  },
  "quiz": {
    "question": "What does Wernicke's area in the temporal lobe handle?",
    "options": [
      "Language comprehension",
      "Motor movement",
      "Visual processing"
    ],
    "correct": 0
  },
