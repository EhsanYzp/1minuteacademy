  "title": "The Amygdala: Fear's Alarm Bell",
  "emoji": "🧠",
  "color": "#7C3AED",
  "description": "One-minute skill: The Amygdala: Fear's Alarm Bell.",
  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "You hear a twig snap in a dark forest and freeze before you even know why. That was your amygdala.",
      "visual": "🌲"
    },
    "buildup": {
      "text": "This almond-sized cluster sits deep in each temporal lobe, scanning for threats constantly.",
      "visual": "🔍"
    },
    "discovery": {
      "text": "It triggers the fight-or-flight response in milliseconds—faster than conscious thought.",
      "visual": "🏃"
    },
    "twist": {
      "text": "It also tags emotional memories, which is why traumatic events are so hard to forget.",
      "visual": "💔"
    },
    "climax": {
      "text": "People with damaged amygdalae feel no fear—they approach snakes and walk into danger without hesitation.",
      "visual": "🐍"
    },
    "punchline": {
      "text": "Fear isn't weakness. It's your amygdala keeping you alive.",
      "visual": "🛡️"
    }
  },
  "quiz": {
    "question": "What does the amygdala primarily process?",
    "options": [
      "Fear and emotional responses",
      "Language comprehension",
      "Motor coordination"
    ],
    "correct": 0
  },
