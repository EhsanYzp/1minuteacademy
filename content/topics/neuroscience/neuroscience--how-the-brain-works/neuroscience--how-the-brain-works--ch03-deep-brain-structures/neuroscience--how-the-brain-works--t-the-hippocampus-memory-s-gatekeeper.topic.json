  "story": {
    "hook": {
      "text": "Patient H.M. had his hippocampi removed to cure epilepsy. He could never form a new memory again.",
      "visual": "🏥"
    },
    "buildup": {
      "text": "The hippocampus is a seahorse-shaped structure deep inside each temporal lobe.",
      "visual": "🐴"
    },
    "discovery": {
      "text": "It converts short-term experiences into long-term memories and stamps them with spatial context.",
      "visual": "📍"
    },
    "twist": {
      "text": "London taxi drivers, who memorize complex routes, have measurably larger hippocampi.",
      "visual": "🚕"
    },
    "climax": {
      "text": "Without it you can recall old memories but never create new ones—trapped in an eternal present.",
      "visual": "⏳"
    },
    "punchline": {
      "text": "Every memory you made today passed through your hippocampus.",
      "visual": "🧠"
    }
  },
  "quiz": {
    "question": "What is the hippocampus primarily responsible for?",
    "options": [
      "Converting short-term memories into long-term ones",
      "Regulating emotions",
      "Processing visual information"
    ],
    "correct": 0
  },
