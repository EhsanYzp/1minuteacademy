  "story": {
    "hook": {
      "text": "Two managers hear the same criticism. The difference is measurable in their brains.",
      "visual": "🧠"
    },
    "buildup": {
      "text": "Emotional intelligence depends on three neural systems: the amygdala for detection, the insula for awareness, and the prefrontal.",
      "visual": "🔺"
    },
    "discovery": {
      "text": "Brain scans show people who score high on emotional intelligence have stronger white matter connections between these three.",
      "visual": "🔗"
    },
    "twist": {
      "text": "Training in emotion labeling--simply naming what you feel--reduces amygdala activation by up to 50 percent in brain imaging.",
      "visual": "🏷️"
    },
    "climax": {
      "text": "Neuroplasticity means these connections strengthen with practice: journaling, therapy, and feedback physically reshape the brain.",
      "visual": "🌱"
    },
    "punchline": {
      "text": "Emotional intelligence is not a personality trait.",
      "visual": "💪"
    }
  },
  "quiz": {
    "question": "What brain effect does emotion labeling produce?",
    "options": [
      "It reduces amygdala activation significantly",
      "It increases cortisol production",
      "It shuts down the prefrontal cortex"
    ],
    "correct": 0
  },
