  "story": {
    "hook": {
      "text": "Eight weeks of daily meditation measurably shrinks the amygdala and thickens the prefrontal cortex.",
      "visual": "🧘"
    },
    "buildup": {
      "text": "Mindfulness meditation trains the brain to observe emotions without reacting—building a gap between stimulus and response.",
      "visual": "⏸️"
    },
    "discovery": {
      "text": "Regular meditators show reduced cortisol levels, lower blood pressure, and decreased anxiety.",
      "visual": "📉"
    },
    "twist": {
      "text": "The changes aren't just psychological—gray matter density physically increases in regions linked to self-awareness.",
      "visual": "📈"
    },
    "climax": {
      "text": "Even brief mindfulness exercises before a stressful event reduce amygdala reactivity in real time.",
      "visual": "⚡"
    },
    "punchline": {
      "text": "Mindfulness doesn't eliminate emotions. It gives you the space to choose how to respond.",
      "visual": "🌊"
    }
  },
  "quiz": {
    "question": "What structural change does meditation cause in the amygdala?",
    "options": [
      "It measurably shrinks the amygdala",
      "It doubles the amygdala in size",
      "It has no effect on brain structure"
    ],
    "correct": 0
  },
