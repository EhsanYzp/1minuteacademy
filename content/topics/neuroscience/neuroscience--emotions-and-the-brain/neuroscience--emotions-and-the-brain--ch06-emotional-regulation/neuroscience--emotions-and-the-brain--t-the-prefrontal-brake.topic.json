  "story": {
    "hook": {
      "text": "Someone insults you. You want to scream. Instead, you take a breath and walk away. Your prefrontal cortex just saved you.",
      "visual": "🧘"
    },
    "buildup": {
      "text": "The prefrontal cortex can inhibit the amygdala's impulses—applying a rational brake to emotional reactions.",
      "visual": "🛑"
    },
    "discovery": {
      "text": "This top-down regulation is the basis of emotional control, patience, and mature social behavior.",
      "visual": "⬇️"
    },
    "twist": {
      "text": "Alcohol weakens this connection—which is why people become emotionally unfiltered when drunk.",
      "visual": "🍺"
    },
    "climax": {
      "text": "Children's prefrontal cortices are still developing, explaining tantrums—their brakes aren't fully installed yet.",
      "visual": "👧"
    },
    "punchline": {
      "text": "Self-control isn't about not feeling. It's about having a strong prefrontal brake.",
      "visual": "⚙️"
    }
  },
  "quiz": {
    "question": "Why do children have more difficulty with emotional regulation?",
    "options": [
      "Their prefrontal cortex is still developing",
      "They have smaller amygdalae",
      "They produce too much serotonin"
    ],
    "correct": 0
  },
