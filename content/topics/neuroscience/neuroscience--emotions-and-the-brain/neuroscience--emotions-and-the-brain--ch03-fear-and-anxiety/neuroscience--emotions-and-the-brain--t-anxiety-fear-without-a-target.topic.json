  "chapter_id": "neuroscience--emotions-and-the-brain--ch03-fear-and-anxiety",
  "title": "Anxiety: Fear Without a Target",
  "emoji": "❤️",
  "color": "#9333EA",
  "description": "A tiny lesson with a big payoff: Anxiety: Fear Without a Target.",
  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "Fear has an object: a spider, a cliff, a mugger. Anxiety is fear that can't find its target.",
      "visual": "😰"
    },
    "buildup": {
      "text": "Anxiety disorders involve the amygdala firing alarm signals when no real threat is present.",
      "visual": "🚨"
    },
    "discovery": {
      "text": "The bed nucleus of the stria terminalis—not the amygdala itself—drives sustained anxiety states.",
      "visual": "🔬"
    },
    "twist": {
      "text": "Anxious brains overestimate threats and underestimate coping ability—a cognitive distortion, not cowardice.",
      "visual": "🔍"
    },
    "climax": {
      "text": "Anxiety disorders are the most common mental illness worldwide, affecting 284 million people.",
      "visual": "🌍"
    },
    "punchline": {
      "text": "Anxiety isn't broken bravery.",
      "visual": "🔔"
    }
  },
  "quiz": {
    "question": "What brain structure drives sustained anxiety states?",
    "options": [
      "The bed nucleus of the stria terminalis",
      "The cerebellum",
      "The occipital lobe"
    ],
    "correct": 0
  },
