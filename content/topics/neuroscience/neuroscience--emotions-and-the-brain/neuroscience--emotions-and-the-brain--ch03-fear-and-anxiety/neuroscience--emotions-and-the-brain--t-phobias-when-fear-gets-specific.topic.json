  "story": {
    "hook": {
      "text": "A grown adult screams at the sight of a butterfly. Irrational? Yes. Real fear? Absolutely.",
      "visual": "🦋"
    },
    "buildup": {
      "text": "Phobias are intense, irrational fears of specific objects or situations—spiders, heights, needles, crowds.",
      "visual": "🕷️"
    },
    "discovery": {
      "text": "The amygdala forms a powerful threat association that persists even when the rational cortex knows it's harmless.",
      "visual": "🧠"
    },
    "twist": {
      "text": "Exposure therapy—gradually facing the fear—is the gold standard. Avoidance makes phobias worse, not better.",
      "visual": "🪜"
    },
    "climax": {
      "text": "Virtual reality exposure therapy now lets patients face fears in controlled digital environments with remarkable success.",
      "visual": "🥽"
    },
    "punchline": {
      "text": "Gradual exposure teaches it to stand down.",
      "visual": "🏳️"
    }
  },
  "quiz": {
    "question": "What is the most effective treatment for phobias?",
    "options": [
      "Gradual exposure therapy",
      "Complete avoidance of the trigger",
      "Medication only"
    ],
    "correct": 0
  },
