  "story": {
    "hook": {
      "text": "You feel angry and your fists clench. You feel scared and your heart races. Emotions live in the body.",
      "visual": "💪"
    },
    "buildup": {
      "text": "Every emotion triggers measurable physical changes: heart rate, breathing, muscle tension, and hormones shift.",
      "visual": "📊"
    },
    "discovery": {
      "text": "The brain orchestrates these changes through the autonomic nervous system and the endocrine system.",
      "visual": "🧠"
    },
    "twist": {
      "text": "William James proposed you don't cry because you're sad—you feel sad because you notice yourself crying.",
      "visual": "😢"
    },
    "climax": {
      "text": "Modern research supports this partly: body signals feed back to the brain and shape the emotion you experience.",
      "visual": "🔄"
    },
    "punchline": {
      "text": "Emotions aren't just in your head. They're a full-body conversation.",
      "visual": "🫀"
    }
  },
  "quiz": {
    "question": "What did William James propose about emotions?",
    "options": [
      "Physical reactions come first, then feelings follow",
      "Emotions exist only in the brain",
      "All emotions are learned behavior"
    ],
    "correct": 0
  },
