  "story": {
    "hook": {
      "text": "You feel a racing heart before a speech. Is it anxiety or excitement? Lisa Feldman Barrett says your brain decides.",
      "visual": "🧠"
    },
    "buildup": {
      "text": "Barrett's theory of constructed emotion argues that emotions are not triggered automatically by fixed circuits in the brain.",
      "visual": "🏗️"
    },
    "discovery": {
      "text": "Instead, the brain combines past experience, body signals, and context to construct an emotion in real time.",
      "visual": "🧩"
    },
    "twist": {
      "text": "The same physical sensation can become fear, thrill, or anger depending on how the brain interprets the situation.",
      "visual": "🔀"
    },
    "climax": {
      "text": "Brain imaging supports this: no single region consistently activates for one emotion. Patterns vary across people and contexts.",
      "visual": "📊"
    },
    "punchline": {
      "text": "Emotions are not reactions.",
      "visual": "🎯"
    }
  },
  "quiz": {
    "question": "What does Barrett's theory of constructed emotion propose?",
    "options": [
      "The brain constructs emotions from experience, body signals, and context",
      "Emotions are hardwired reflexes that never change",
      "Emotions are entirely learned from social interaction"
    ],
    "correct": 0
  },
