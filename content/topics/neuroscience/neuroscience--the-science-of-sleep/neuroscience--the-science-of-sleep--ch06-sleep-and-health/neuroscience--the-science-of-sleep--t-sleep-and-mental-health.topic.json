  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "After one sleepless night, anxiety levels spike by 30%. After several, depression risk doubles.",
      "visual": "😟"
    },
    "buildup": {
      "text": "Sleep loss amplifies the amygdala's reactivity—making emotional responses bigger and harder to control.",
      "visual": "🌋"
    },
    "discovery": {
      "text": "The connection between the amygdala and prefrontal cortex weakens without sleep—emotional brakes fail.",
      "visual": "🔗"
    },
    "twist": {
      "text": "Every major psychiatric condition—depression, bipolar, PTSD, schizophrenia—involves disrupted sleep as a core feature.",
      "visual": "🩺"
    },
    "climax": {
      "text": "Treating sleep problems alone can reduce symptoms of depression by 50% in some clinical trials.",
      "visual": "📉"
    },
    "punchline": {
      "text": "Sleep is not separate from mental health. It is the foundation it stands upon.",
      "visual": "🏛️"
    }
  },
  "quiz": {
    "question": "How does sleep loss affect the amygdala?",
    "options": [
      "It amplifies its reactivity to emotional stimuli",
      "It shuts the amygdala down completely",
      "It has no measurable effect"
    ],
    "correct": 0
  },
