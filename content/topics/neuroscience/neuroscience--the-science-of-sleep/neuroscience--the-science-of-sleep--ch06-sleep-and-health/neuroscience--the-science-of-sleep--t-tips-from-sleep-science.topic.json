  "story": {
    "hook": {
      "text": "Neuroscience has tested dozens of sleep tips. Most folk remedies fail. A few strategies genuinely work.",
      "visual": "🔬"
    },
    "buildup": {
      "text": "Keep a consistent sleep schedule—even on weekends. Your circadian clock hates surprises.",
      "visual": "📅"
    },
    "discovery": {
      "text": "Cool your bedroom to around 18°C. Core body temperature must drop for sleep onset to occur.",
      "visual": "❄️"
    },
    "twist": {
      "text": "Avoid screens an hour before bed—or use blue-light filters. Even dim blue light suppresses melatonin.",
      "visual": "📱"
    },
    "climax": {
      "text": "If you can't sleep after 20 minutes, get up and do something boring until you feel sleepy again.",
      "visual": "📖"
    },
    "punchline": {
      "text": "Good sleep isn't luck. It's a set of evidence-based habits practiced consistently.",
      "visual": "✅"
    }
  },
  "quiz": {
    "question": "What bedroom temperature does sleep science recommend?",
    "options": [
      "Around 18°C (65°F)",
      "Around 25°C (77°F)",
      "As warm as possible"
    ],
    "correct": 0
  },
