  "story": {
    "hook": {
      "text": "Sleep less and you eat more. It's not willpower failure—it's hormones gone haywire.",
      "visual": "🍔"
    },
    "buildup": {
      "text": "Sleep deprivation increases ghrelin, the hunger hormone, and decreases leptin, the satiety hormone.",
      "visual": "📈"
    },
    "discovery": {
      "text": "Just four nights of short sleep causes the body to crave high-calorie, high-carb foods specifically.",
      "visual": "🍩"
    },
    "twist": {
      "text": "The prefrontal cortex—your impulse control center—is impaired by sleep loss, weakening your ability to resist cravings.",
      "visual": "🧠"
    },
    "climax": {
      "text": "People sleeping under six hours regularly have a 30% higher risk of obesity than those sleeping seven to eight.",
      "visual": "📊"
    },
    "punchline": {
      "text": "Diet and exercise matter. But without sleep, your hormones sabotage both.",
      "visual": "⚖️"
    }
  },
  "quiz": {
    "question": "What happens to ghrelin levels with sleep deprivation?",
    "options": [
      "Ghrelin increases, making you hungrier",
      "Ghrelin decreases, reducing appetite",
      "Ghrelin stays the same"
    ],
    "correct": 0
  },
