  "story": {
    "hook": {
      "text": "Put a person in a cave with no clocks or sunlight. They'll still sleep and wake on roughly a 24-hour cycle.",
      "visual": "🕳️"
    },
    "buildup": {
      "text": "The circadian clock is a biological timer built into nearly every cell of your body.",
      "visual": "⏰"
    },
    "discovery": {
      "text": "Its master pacemaker is the suprachiasmatic nucleus—a tiny cluster of 20,000 neurons above the optic nerves.",
      "visual": "🔬"
    },
    "twist": {
      "text": "The human clock runs slightly longer than 24 hours, which is why it needs daily resetting by light.",
      "visual": "☀️"
    },
    "climax": {
      "text": "Without light cues, blind individuals often develop non-24-hour sleep-wake disorder, drifting off schedule.",
      "visual": "🌑"
    },
    "punchline": {
      "text": "You carry a clock in your brain that has been ticking since before you were born.",
      "visual": "🧠"
    }
  },
  "quiz": {
    "question": "Where is the brain's master circadian clock located?",
    "options": [
      "The suprachiasmatic nucleus",
      "The hippocampus",
      "The cerebellum"
    ],
    "correct": 0
  },
