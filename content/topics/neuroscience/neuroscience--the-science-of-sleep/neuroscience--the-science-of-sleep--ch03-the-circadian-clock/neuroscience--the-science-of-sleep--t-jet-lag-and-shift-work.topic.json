  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "Fly from New York to Tokyo and your body insists it's 3 AM while the sun blazes outside. That's jet lag.",
      "visual": "✈️"
    },
    "buildup": {
      "text": "Jet lag occurs because your internal clock can only shift about one hour per day.",
      "visual": "⏰"
    },
    "discovery": {
      "text": "A 9-hour time zone jump means roughly 9 days of gradual adjustment for full recovery.",
      "visual": "📅"
    },
    "twist": {
      "text": "Eastward travel is harder than westward because it requires advancing your clock, which is more difficult.",
      "visual": "🧭"
    },
    "climax": {
      "text": "Chronic shift workers face higher rates of heart disease, obesity, and cancer—their clocks never fully adapt.",
      "visual": "💔"
    },
    "punchline": {
      "text": "Your circadian clock is stubborn. Fight it long enough and your health pays the price.",
      "visual": "⚠️"
    }
  },
  "quiz": {
    "question": "Why is eastward travel harder for jet lag recovery?",
    "options": [
      "It requires advancing your clock, which is more difficult",
      "Planes fly faster going east",
      "Eastern time zones have less sunlight"
    ],
    "correct": 0
  },
