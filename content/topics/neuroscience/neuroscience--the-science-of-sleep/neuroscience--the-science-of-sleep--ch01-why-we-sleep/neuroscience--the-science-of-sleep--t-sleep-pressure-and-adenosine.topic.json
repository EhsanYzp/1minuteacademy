  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "The longer you stay awake, the sleepier you feel. That growing pressure has a chemical name: adenosine.",
      "visual": "⬆️"
    },
    "buildup": {
      "text": "Adenosine accumulates in the brain as a byproduct of neural activity throughout the day.",
      "visual": "🧪"
    },
    "discovery": {
      "text": "It binds to receptors that gradually slow neural firing, making you feel drowsy and unfocused.",
      "visual": "😴"
    },
    "twist": {
      "text": "Caffeine works by blocking adenosine receptors—it doesn't reduce tiredness, just hides it.",
      "visual": "☕"
    },
    "climax": {
      "text": "When caffeine wears off, all that accumulated adenosine hits at once—the dreaded afternoon crash.",
      "visual": "💥"
    },
    "punchline": {
      "text": "Adenosine is your brain's sleep debt counter. Only real sleep resets it.",
      "visual": "🔄"
    }
  },
  "quiz": {
    "question": "How does caffeine reduce sleepiness?",
    "options": [
      "By blocking adenosine receptors",
      "By producing more dopamine",
      "By increasing blood oxygen"
    ],
    "correct": 0
  },
