  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "Two invisible forces control when you sleep: one builds pressure all day, the other follows the sun.",
      "visual": "⚖️"
    },
    "buildup": {
      "text": "Process S is homeostatic sleep pressure, driven by adenosine buildup the longer you stay awake.",
      "visual": "📈"
    },
    "discovery": {
      "text": "Process C is the circadian rhythm, a 24-hour biological wave that promotes wakefulness during daylight.",
      "visual": "🌞"
    },
    "twist": {
      "text": "These two systems operate independently. Even if you slept all day, your circadian clock still dips at night.",
      "visual": "🔄"
    },
    "climax": {
      "text": "The sleepiest moments occur when high adenosine pressure aligns with the circadian low point, around 2 to 4 AM.",
      "visual": "🌃"
    },
    "punchline": {
      "text": "Sleep is not one switch. It is two systems voting together on when to shut you down.",
      "visual": "🗳️"
    }
  },
  "quiz": {
    "question": "What are the two processes in the two-process model of sleep?",
    "options": [
      "Homeostatic sleep pressure and the circadian rhythm",
      "REM and non-REM cycles",
      "Melatonin release and cortisol suppression"
    ],
    "correct": 0
  },
