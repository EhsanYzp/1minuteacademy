  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "Your partner snores, goes silent for ten seconds, then gasps violently. They stopped breathing—again.",
      "visual": "😮‍💨"
    },
    "buildup": {
      "text": "Obstructive sleep apnea occurs when throat muscles relax and block the airway during sleep.",
      "visual": "🫁"
    },
    "discovery": {
      "text": "The brain jolts the sleeper partially awake to reopen the airway—sometimes hundreds of times per night.",
      "visual": "⚡"
    },
    "twist": {
      "text": "Most people with apnea don't know they have it. They just feel exhausted every morning without understanding why.",
      "visual": "😴"
    },
    "climax": {
      "text": "Untreated apnea doubles the risk of heart attack, stroke, and high blood pressure.",
      "visual": "❤️"
    },
    "punchline": {
      "text": "If you snore loudly and wake tired, your airway may be closing hundreds of times.",
      "visual": "⚠️"
    }
  },
  "quiz": {
    "question": "What causes obstructive sleep apnea?",
    "options": [
      "Throat muscles relaxing and blocking the airway",
      "Overactive brain signals",
      "Too much melatonin"
    ],
    "correct": 0
  },
