  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "A man drove 23 kilometers while sleepwalking and had no memory of it the next morning.",
      "visual": "🚗"
    },
    "buildup": {
      "text": "Sleepwalking occurs during deep sleep when motor systems activate while consciousness stays offline.",
      "visual": "🚶"
    },
    "discovery": {
      "text": "The brain is partially awake: motor cortex and brainstem are active, but the prefrontal cortex stays asleep.",
      "visual": "🧠"
    },
    "twist": {
      "text": "Sleepwalkers can navigate complex environments, open doors, and even cook—all without awareness.",
      "visual": "🍳"
    },
    "climax": {
      "text": "Sleep deprivation and stress dramatically increase sleepwalking episodes in people prone to it.",
      "visual": "😰"
    },
    "punchline": {
      "text": "Sleepwalking proves your brain can move your body without ever waking your mind.",
      "visual": "👻"
    }
  },
  "quiz": {
    "question": "During which sleep stage does sleepwalking occur?",
    "options": [
      "Deep sleep (Stage 3)",
      "REM sleep",
      "Stage 1 light sleep"
    ],
    "correct": 0
  },
