  "story": {
    "hook": {
      "text": "Imagine falling asleep mid-conversation, mid-meal, or while driving. For narcoleptics, this is daily life.",
      "visual": "😵"
    },
    "buildup": {
      "text": "Narcolepsy is caused by the loss of neurons that produce hypocretin—a chemical that stabilizes wakefulness.",
      "visual": "🧪"
    },
    "discovery": {
      "text": "Without hypocretin, the brain can't maintain stable boundaries between wakefulness, REM, and deep sleep.",
      "visual": "🔀"
    },
    "twist": {
      "text": "Cataplexy, a symptom of narcolepsy, causes sudden muscle collapse triggered by strong emotions like laughter.",
      "visual": "😂"
    },
    "climax": {
      "text": "The immune system is suspected of destroying hypocretin neurons—narcolepsy may be an autoimmune disease.",
      "visual": "🛡️"
    },
    "punchline": {
      "text": "Narcolepsy isn't laziness. It's a brain that lost the chemical keeping it awake.",
      "visual": "🧠"
    }
  },
  "quiz": {
    "question": "What chemical is deficient in narcolepsy?",
    "options": [
      "Hypocretin (orexin)",
      "Melatonin",
      "Serotonin"
    ],
    "correct": 0
  },
