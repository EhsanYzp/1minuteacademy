  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "After a neurotransmitter delivers its message, it can't just linger. The synapse needs to reset fast.",
      "visual": "🧹"
    },
    "buildup": {
      "text": "Three cleanup methods exist: reuptake, enzymatic breakdown, and diffusion away from the synapse.",
      "visual": "🔄"
    },
    "discovery": {
      "text": "Reuptake pumps suck neurotransmitters back into the sending neuron for recycling.",
      "visual": "♻️"
    },
    "twist": {
      "text": "Antidepressants like SSRIs block serotonin reuptake, letting serotonin linger longer in the gap.",
      "visual": "💊"
    },
    "climax": {
      "text": "Cocaine blocks dopamine reuptake—flooding the synapse with pleasure signals and driving addiction.",
      "visual": "⚠️"
    },
    "punchline": {
      "text": "How a signal ends matters as much as how it starts.",
      "visual": "🏁"
    }
  },
  "quiz": {
    "question": "What do SSRIs block?",
    "options": [
      "Serotonin reuptake",
      "Dopamine production",
      "Sodium channels"
    ],
    "correct": 0
  },
