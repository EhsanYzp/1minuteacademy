  "description": "Learn Electrical Synapses: The Direct Connection in one minute.",
  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "Not all synapses use chemicals. Some neurons connect through direct channels that pass electricity instantly.",
      "visual": "🔌"
    },
    "buildup": {
      "text": "Gap junctions are protein tunnels that physically bridge two neurons, letting ions flow straight through.",
      "visual": "🌉"
    },
    "discovery": {
      "text": "Signals cross these junctions in microseconds, far faster than the millisecond delay at chemical synapses.",
      "visual": "⚡"
    },
    "twist": {
      "text": "This speed is critical in circuits that demand perfect synchrony, like the neurons controlling your heartbeat.",
      "visual": "❤️"
    },
    "climax": {
      "text": "Electrical synapses also appear in the brain, synchronizing groups of neurons that need to fire together.",
      "visual": "🎶"
    },
    "punchline": {
      "text": "When speed matters more than flexibility, neurons skip the chemistry and go electric.",
      "visual": "💨"
    }
  },
  "quiz": {
    "question": "What structures form electrical synapses between neurons?",
    "options": [
      "Gap junctions",
      "Synaptic vesicles",
      "Myelin sheaths"
    ],
    "correct": 0
  },
