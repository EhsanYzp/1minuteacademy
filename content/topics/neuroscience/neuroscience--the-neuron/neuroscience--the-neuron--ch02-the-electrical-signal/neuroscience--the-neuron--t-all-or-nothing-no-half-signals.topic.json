  "story": {
    "hook": {
      "text": "Neurons don't whisper. They either fire at full strength or they don't fire at all.",
      "visual": "🔊"
    },
    "buildup": {
      "text": "If the stimulus reaches threshold, the action potential fires at maximum voltage. No partial signals exist.",
      "visual": "📶"
    },
    "discovery": {
      "text": "So how does the brain encode intensity? Not by bigger signals, but by faster firing rates.",
      "visual": "🥁"
    },
    "twist": {
      "text": "A gentle touch might trigger 10 spikes per second. A sharp pain triggers 100.",
      "visual": "📊"
    },
    "climax": {
      "text": "The brain reads frequency like Morse code—more dots per second means a stronger stimulus.",
      "visual": "📟"
    },
    "punchline": {
      "text": "Neurons speak in frequency, not volume. Faster means stronger.",
      "visual": "🎵"
    }
  },
  "quiz": {
    "question": "How does the brain encode stimulus intensity?",
    "options": [
      "Through firing rate frequency",
      "Through larger action potentials",
      "Through wider axons"
    ],
    "correct": 0
  },
