  "story": {
    "hook": {
      "text": "Ninety percent of your body's serotonin is in your gut, not your brain. Yet it shapes your mood.",
      "visual": "🫄"
    },
    "buildup": {
      "text": "In the brain, serotonin modulates mood, appetite, sleep, and social behavior.",
      "visual": "😊"
    },
    "discovery": {
      "text": "Low serotonin levels are linked to depression, anxiety, and obsessive-compulsive disorder.",
      "visual": "😞"
    },
    "twist": {
      "text": "Psychedelics like LSD and psilocybin work by binding to serotonin receptors—mimicking its shape.",
      "visual": "🍄"
    },
    "climax": {
      "text": "Sunlight boosts serotonin production, which explains why winter darkness worsens mood for many people.",
      "visual": "☀️"
    },
    "punchline": {
      "text": "Serotonin doesn't make you happy. It makes you stable.",
      "visual": "⚖️"
    }
  },
  "quiz": {
    "question": "Where is most of the body's serotonin found?",
    "options": [
      "In the gut",
      "In the brain",
      "In the muscles"
    ],
    "correct": 0
  },
