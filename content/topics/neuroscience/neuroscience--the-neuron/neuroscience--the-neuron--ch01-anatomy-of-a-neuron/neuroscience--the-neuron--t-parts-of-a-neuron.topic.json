  "story": {
    "hook": {
      "text": "A neuron looks like a tiny tree: branches on one end, a long trunk, and roots on the other.",
      "visual": "🌳"
    },
    "buildup": {
      "text": "Dendrites are the branches—they receive signals from other neurons and pass them inward.",
      "visual": "🌿"
    },
    "discovery": {
      "text": "The cell body, or soma, processes those signals and decides whether to fire its own.",
      "visual": "🏠"
    },
    "twist": {
      "text": "The axon is the trunk—a cable that can stretch over a meter from spinal cord to toe.",
      "visual": "📏"
    },
    "climax": {
      "text": "At the axon's end, terminal buttons release chemicals to signal the next neuron in line.",
      "visual": "📤"
    },
    "punchline": {
      "text": "Dendrites listen. The soma decides. The axon delivers.",
      "visual": "⚡"
    }
  },
  "quiz": {
    "question": "What part of the neuron receives incoming signals?",
    "options": [
      "Dendrites",
      "The axon",
      "The terminal buttons"
    ],
    "correct": 0
  },
