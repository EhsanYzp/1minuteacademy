  "story": {
    "hook": {
      "text": "The longest axons in your body stretch from your lower spine to your big toe—roughly a meter.",
      "visual": "🦶"
    },
    "buildup": {
      "text": "Axons carry electrical impulses away from the cell body toward other neurons, muscles, or glands.",
      "visual": "🔌"
    },
    "discovery": {
      "text": "They're wrapped in myelin sheaths with tiny gaps called nodes of Ranvier between segments.",
      "visual": "🧅"
    },
    "twist": {
      "text": "The signal leaps from node to node—called saltatory conduction—multiplying speed dramatically.",
      "visual": "🐇"
    },
    "climax": {
      "text": "In multiple sclerosis, the immune system attacks myelin, slowing or blocking these signals.",
      "visual": "🩺"
    },
    "punchline": {
      "text": "The axon is biology's fiber-optic cable: insulated for speed.",
      "visual": "💨"
    }
  },
  "quiz": {
    "question": "What is saltatory conduction?",
    "options": [
      "Signal leaping between nodes of Ranvier",
      "Signals flowing through dendrites",
      "Chemical release at the synapse"
    ],
    "correct": 0
  },
