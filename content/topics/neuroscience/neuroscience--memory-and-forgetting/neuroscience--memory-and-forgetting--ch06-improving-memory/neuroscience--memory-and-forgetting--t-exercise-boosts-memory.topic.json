  "title": "Exercise Boosts Memory",
  "emoji": "🗃️",
  "color": "#6D28D9",
  "description": "A short lesson to help you apply Exercise Boosts Memory.",
  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "A single 30-minute jog can improve your memory test scores for hours afterward.",
      "visual": "🏃"
    },
    "buildup": {
      "text": "Aerobic exercise increases blood flow to the brain and triggers release of growth factors like BDNF.",
      "visual": "💉"
    },
    "discovery": {
      "text": "BDNF promotes neurogenesis in the hippocampus—literally growing new neurons involved in memory.",
      "visual": "🌱"
    },
    "twist": {
      "text": "Sedentary adults who start exercising show measurable hippocampal growth within just three months.",
      "visual": "📈"
    },
    "climax": {
      "text": "Regular exercisers have significantly lower rates of dementia and Alzheimer's in long-term studies.",
      "visual": "📊"
    },
    "punchline": {
      "text": "Moving your body is one of the most powerful things you can do for your brain.",
      "visual": "💪"
    }
  },
  "quiz": {
    "question": "What does BDNF promote in the hippocampus?",
    "options": [
      "Growth of new neurons",
      "Destruction of old synapses",
      "Myelin breakdown"
    ],
    "correct": 0
  },
