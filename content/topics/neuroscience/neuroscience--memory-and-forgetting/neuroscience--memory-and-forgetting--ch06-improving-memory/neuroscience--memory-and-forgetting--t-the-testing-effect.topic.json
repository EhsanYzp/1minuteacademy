  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "Taking a test isn't just a way to measure learning. The act of testing itself is a powerful learning tool.",
      "visual": "📝"
    },
    "buildup": {
      "text": "Retrieving information from memory strengthens the neural pathways associated with that knowledge.",
      "visual": "🛤️"
    },
    "discovery": {
      "text": "Students who take practice tests retain 50% more material than those who only reread their notes.",
      "visual": "📊"
    },
    "twist": {
      "text": "Even getting the answer wrong improves learning—failed retrieval attempts prime the brain for the correction.",
      "visual": "❌"
    },
    "climax": {
      "text": "The testing effect works for all ages and subjects, from vocabulary to medical diagnosis.",
      "visual": "🌍"
    },
    "punchline": {
      "text": "Don't just study the material. Quiz yourself. That's where memory gets built.",
      "visual": "🧠"
    }
  },
  "quiz": {
    "question": "Why does taking practice tests improve memory?",
    "options": [
      "Retrieval strengthens neural pathways",
      "It reduces anxiety about exams",
      "It increases reading speed"
    ],
    "correct": 0
  },
