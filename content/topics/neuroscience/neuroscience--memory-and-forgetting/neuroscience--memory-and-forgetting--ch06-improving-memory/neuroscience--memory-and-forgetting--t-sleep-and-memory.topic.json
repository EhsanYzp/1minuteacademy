  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "Students who pull all-nighters before exams score worse than those who study less but sleep well.",
      "visual": "📉"
    },
    "buildup": {
      "text": "During sleep, the hippocampus replays the day's experiences to the cortex for long-term storage.",
      "visual": "🔄"
    },
    "discovery": {
      "text": "Slow-wave sleep consolidates facts and events. REM sleep strengthens procedural and emotional memories.",
      "visual": "🌙"
    },
    "twist": {
      "text": "Sleep also prunes weak connections, making remaining memories clearer and more accessible.",
      "visual": "✂️"
    },
    "climax": {
      "text": "Even a brief nap between study sessions improves recall by 20% compared to staying awake.",
      "visual": "😴"
    },
    "punchline": {
      "text": "The best study hack is the oldest one: get enough sleep.",
      "visual": "🛌"
    }
  },
  "quiz": {
    "question": "What type of sleep consolidates factual memories?",
    "options": [
      "Slow-wave sleep",
      "REM sleep",
      "Light sleep stage 1"
    ],
    "correct": 0
  },
