  "story": {
    "hook": {
      "text": "Memory champions memorize the order of a shuffled deck of cards in under a minute. Their secret is ancient.",
      "visual": "🃏"
    },
    "buildup": {
      "text": "The method of loci places items to remember along a familiar route—like rooms in your house.",
      "visual": "🏠"
    },
    "discovery": {
      "text": "You mentally walk the route, placing vivid images at each location: a giant banana on the couch, a singing fish on the stairs.",
      "visual": "🐟"
    },
    "twist": {
      "text": "Brain scans show this technique activates spatial navigation areas—the hippocampus loves location cues.",
      "visual": "📍"
    },
    "climax": {
      "text": "After six weeks of training, ordinary people can match memory athletes' performance in competitions.",
      "visual": "🏆"
    },
    "punchline": {
      "text": "You don't need a gifted brain. You need a good route and bizarre images.",
      "visual": "🗺️"
    }
  },
  "quiz": {
    "question": "What brain region does the method of loci primarily engage?",
    "options": [
      "The hippocampus and spatial navigation areas",
      "The occipital lobe exclusively",
      "The brainstem"
    ],
    "correct": 0
  },
