  "story": {
    "hook": {
      "text": "Your first kiss. A childhood birthday party. The smell of your grandmother's kitchen. These are episodic memories.",
      "visual": "🎂"
    },
    "buildup": {
      "text": "Episodic memory stores personal experiences stamped with time, place, and emotional context.",
      "visual": "📅"
    },
    "discovery": {
      "text": "The hippocampus is essential for forming new episodic memories but not for storing old ones.",
      "visual": "🏛️"
    },
    "twist": {
      "text": "People with severely damaged hippocampi can recall childhood events but can't remember yesterday.",
      "visual": "🔙"
    },
    "climax": {
      "text": "Episodic memory is one of the first systems to decline in Alzheimer's disease.",
      "visual": "🧓"
    },
    "punchline": {
      "text": "Episodic memory is your autobiography, written by your brain in real time.",
      "visual": "📖"
    }
  },
  "quiz": {
    "question": "What type of information does episodic memory store?",
    "options": [
      "Personal experiences with time and place",
      "General facts about the world",
      "Motor skills like riding a bike"
    ],
    "correct": 0
  },
