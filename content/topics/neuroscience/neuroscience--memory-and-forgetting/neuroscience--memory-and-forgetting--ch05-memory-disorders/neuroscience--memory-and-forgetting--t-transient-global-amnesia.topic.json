  "description": "A quick, practical guide to Transient Global Amnesia.",
  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "A healthy person suddenly cannot form new memories. They repeat the same questions every few minutes. Hours later, they are fine.",
      "visual": "😶"
    },
    "buildup": {
      "text": "Transient global amnesia strikes without warning, usually in adults over 50, and resolves completely within 24 hours.",
      "visual": "⏳"
    },
    "discovery": {
      "text": "During an episode, the person retains identity and motor skills but cannot remember anything happening in the present moment.",
      "visual": "🔄"
    },
    "twist": {
      "text": "Brain scans reveal temporary disruption of blood flow or activity in the hippocampus, but the exact cause remains a mystery.",
      "visual": "🧠"
    },
    "climax": {
      "text": "It almost never recurs, leaves no lasting damage, and the person has no memory of the episode itself once it ends.",
      "visual": "🕳️"
    },
    "punchline": {
      "text": "Then it switches back on as if nothing happened.",
      "visual": "📴"
    }
  },
  "quiz": {
    "question": "How long does transient global amnesia typically last?",
    "options": [
      "It resolves within 24 hours",
      "It lasts for several weeks",
      "It is a permanent condition"
    ],
    "correct": 0
  },
