  "published": true,
  "story": {
    "hook": {
      "text": "You vividly remember getting lost in a mall as a child. It never happened. A psychologist planted it.",
      "visual": "🏬"
    },
    "buildup": {
      "text": "Elizabeth Loftus showed that detailed false memories can be implanted through suggestion and imagination.",
      "visual": "🧑‍🔬"
    },
    "discovery": {
      "text": "About 25% of her subjects developed rich, confident memories of events that never occurred.",
      "visual": "📊"
    },
    "twist": {
      "text": "Brain scans can't reliably distinguish false memories from real ones—both activate the same regions.",
      "visual": "🧠"
    },
    "climax": {
      "text": "False memory research transformed legal systems, revealing how police questioning can create fake confessions.",
      "visual": "⚖️"
    },
    "punchline": {
      "text": "Your most vivid memory might be fiction your brain wrote and then believed.",
      "visual": "📝"
    }
  },
  "quiz": {
    "question": "Who is famous for research on false memory implantation?",
    "options": [
      "Elizabeth Loftus",
      "Sigmund Freud",
      "Karl Lashley"
    ],
    "correct": 0
  },
