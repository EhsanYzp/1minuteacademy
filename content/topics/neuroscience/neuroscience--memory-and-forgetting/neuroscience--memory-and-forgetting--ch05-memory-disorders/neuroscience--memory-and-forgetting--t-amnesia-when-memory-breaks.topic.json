  "story": {
    "hook": {
      "text": "Clive Wearing can play piano beautifully but doesn't remember learning. His memory resets every 30 seconds.",
      "visual": "🎹"
    },
    "buildup": {
      "text": "Amnesia is severe memory loss caused by brain injury, disease, or psychological trauma.",
      "visual": "🩺"
    },
    "discovery": {
      "text": "Anterograde amnesia prevents forming new memories. Retrograde amnesia erases past ones.",
      "visual": "⏪"
    },
    "twist": {
      "text": "Most amnesia patients keep their procedural memory—they can learn new skills without knowing they practiced.",
      "visual": "🤯"
    },
    "climax": {
      "text": "Clive greets his wife with overwhelming joy every time she enters—each visit feels like the first in years.",
      "visual": "❤️"
    },
    "punchline": {
      "text": "Amnesia shows that identity and ability can survive when memory cannot.",
      "visual": "🧠"
    }
  },
  "quiz": {
    "question": "What is anterograde amnesia?",
    "options": [
      "Inability to form new memories",
      "Loss of all past memories",
      "Inability to learn motor skills"
    ],
    "correct": 0
  },
