  "story": {
    "hook": {
      "text": "Scientists spent decades hunting for a single memory vault in the brain. It does not exist.",
      "visual": "🔍"
    },
    "buildup": {
      "text": "Every memory is broken into fragments: sights, sounds, emotions, and context, each stored in a different region.",
      "visual": "🧩"
    },
    "discovery": {
      "text": "The visual cortex holds what you saw, the auditory cortex holds what you heard, and the amygdala holds how you felt.",
      "visual": "🗺️"
    },
    "twist": {
      "text": "Removing one brain region does not erase a memory entirely. It only removes one dimension of the experience.",
      "visual": "✂️"
    },
    "climax": {
      "text": "Karl Lashley called this the engram problem. After decades of cutting rat brains, he concluded memory is everywhere.",
      "visual": "🐀"
    },
    "punchline": {
      "text": "A single memory has no single home. It lives scattered across your entire brain.",
      "visual": "🌐"
    }
  },
  "quiz": {
    "question": "Why is it impossible to destroy a memory by removing one brain region?",
    "options": [
      "Because memories are distributed across multiple regions",
      "Because memories are stored only in the spinal cord",
      "Because memories disappear on their own after a week"
    ],
    "correct": 0
  },
