  "chapter_id": "neuroscience--memory-and-forgetting--ch04-why-we-forget",
  "title": "The Misinformation Effect",
  "emoji": "🗃️",
  "color": "#6D28D9",
  "description": "A 60-second lesson on The Misinformation Effect.",
  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "A witness sees a car crash at a stop sign. A lawyer asks about the yield sign. Now the witness remembers a yield sign.",
      "visual": "🛑"
    },
    "buildup": {
      "text": "The misinformation effect occurs when information received after an event distorts the original memory of that event.",
      "visual": "📰"
    },
    "discovery": {
      "text": "Elizabeth Loftus demonstrated this by changing a single word in a question and reliably altering what people remembered.",
      "visual": "🧑‍🔬"
    },
    "twist": {
      "text": "The new information does not just sit alongside the old memory.",
      "visual": "💾"
    },
    "climax": {
      "text": "Police interviews, news coverage, and conversations with other witnesses can all inject misinformation into real memories.",
      "visual": "🗞️"
    },
    "punchline": {
      "text": "What you remember is not just what you saw. It is also what you were told afterward.",
      "visual": "👁️"
    }
  },
  "quiz": {
    "question": "What does the misinformation effect demonstrate?",
    "options": [
      "Post-event information can alter original memories",
      "Memories are always perfectly accurate recordings",
      "Only children are susceptible to false suggestions"
    ],
    "correct": 0
  },
