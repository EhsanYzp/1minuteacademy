  "story": {
    "hook": {
      "text": "A crow uses a stick as a tool to extract a grub from a log. It pauses, considers a different stick, and switches. Is it conscious?",
      "visual": "🐦"
    },
    "buildup": {
      "text": "Many animals display behaviors that suggest awareness: problem-solving, emotional responses, and even self-recognition in mirrors.",
      "visual": "🪞"
    },
    "discovery": {
      "text": "The 2012 Cambridge Declaration stated that many non-human animals possess the neurological substrates for conscious experience.",
      "visual": "📜"
    },
    "twist": {
      "text": "Octopuses, with brains organized completely differently from mammals, still demonstrate complex problem-solving and apparent.",
      "visual": "🐙"
    },
    "climax": {
      "text": "Consciousness may not require a cortex at all. It may emerge from any sufficiently complex information-processing system.",
      "visual": "💻"
    },
    "punchline": {
      "text": "If consciousness is not unique to humans, the question shifts from who has it to what.",
      "visual": "🌍"
    }
  },
  "quiz": {
    "question": "What did the 2012 Cambridge Declaration on Consciousness state?",
    "options": [
      "Many non-human animals have neurological substrates for conscious experience",
      "Only humans are capable of consciousness",
      "Consciousness requires a neocortex"
    ],
    "correct": 0
  },
