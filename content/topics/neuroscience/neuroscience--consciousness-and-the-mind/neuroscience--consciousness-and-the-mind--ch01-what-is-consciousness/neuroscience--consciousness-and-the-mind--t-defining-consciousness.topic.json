  "story": {
    "hook": {
      "text": "You are reading this sentence right now. That knowing is consciousness, and no one fully understands how it works.",
      "visual": "🤔"
    },
    "buildup": {
      "text": "Consciousness is the subjective experience of being aware: of seeing colors, feeling pain, thinking thoughts, and knowing you.",
      "visual": "🌈"
    },
    "discovery": {
      "text": "It involves both awareness of the environment and awareness of your own internal states, like hunger, sadness, or curiosity.",
      "visual": "🔍"
    },
    "twist": {
      "text": "Billions of neurons fire in your brain at every moment, but only a tiny fraction of activity ever becomes conscious experience.",
      "visual": "⚡"
    },
    "climax": {
      "text": "Consciousness is the most familiar thing in your life and the most mysterious thing in all of science.",
      "visual": "🌌"
    },
    "punchline": {
      "text": "You experience it every waking second, yet no one can explain how matter becomes aware.",
      "visual": "🧠"
    }
  },
  "quiz": {
    "question": "What is consciousness?",
    "options": [
      "The subjective experience of being aware",
      "The total number of neurons firing at once",
      "The ability to move voluntarily"
    ],
    "correct": 0
  },
