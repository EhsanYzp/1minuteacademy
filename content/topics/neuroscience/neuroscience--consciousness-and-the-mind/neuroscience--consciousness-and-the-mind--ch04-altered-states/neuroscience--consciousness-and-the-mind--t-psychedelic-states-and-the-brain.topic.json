  "story": {
    "hook": {
      "text": "Under psilocybin, brain networks normally never communicate suddenly start talking to each other in a burst of chaotic.",
      "visual": "🍄"
    },
    "buildup": {
      "text": "Psychedelics primarily act on serotonin 2A receptors, disrupting the default mode network, which maintains your sense of self.",
      "visual": "🧬"
    },
    "discovery": {
      "text": "Brain imaging during psychedelic experiences shows massively increased entropy, meaning the brain explores states it normally.",
      "visual": "🌀"
    },
    "twist": {
      "text": "This increased connectivity may explain why a single psychedelic session can produce lasting changes in personality, creativity.",
      "visual": "🌅"
    },
    "climax": {
      "text": "Clinical trials show psilocybin can treat depression and end-of-life anxiety with effects lasting months after a single dose.",
      "visual": "💊"
    },
    "punchline": {
      "text": "Psychedelics do not add something to the brain.",
      "visual": "🚿"
    }
  },
  "quiz": {
    "question": "What happens to the default mode network under psychedelics?",
    "options": [
      "It is disrupted, reducing the sense of self",
      "It becomes hyperactive, strengthening identity",
      "It shuts down permanently"
    ],
    "correct": 0
  },
