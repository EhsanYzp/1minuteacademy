  "story": {
    "hook": {
      "text": "Buddhist monks with over 10,000 hours of meditation practice produce gamma wave patterns so powerful neuroscientists initially.",
      "visual": "🧘"
    },
    "buildup": {
      "text": "Meditation encompasses many techniques, from focused-attention practices sharpen concentration to open-monitoring practices.",
      "visual": "🌿"
    },
    "discovery": {
      "text": "Brain imaging reveals meditation reduces activity in the default mode network, the system responsible for mind-wandering.",
      "visual": "📉"
    },
    "twist": {
      "text": "Long-term meditators show thicker cortical regions, increased gray matter in the hippocampus, and reduced amygdala volume.",
      "visual": "🔬"
    },
    "climax": {
      "text": "Some advanced practitioners report states of pure awareness without content, consciousness with nothing in it, a state unlike.",
      "visual": "✨"
    },
    "punchline": {
      "text": "Meditation does not empty the mind.",
      "visual": "🪷"
    }
  },
  "quiz": {
    "question": "What happens to the default mode network during meditation?",
    "options": [
      "Its activity is reduced, quieting mind-wandering and self-referential thought",
      "It becomes hyperactive, increasing creative thinking",
      "It shuts down entirely, causing unconsciousness"
    ],
    "correct": 0
  },
