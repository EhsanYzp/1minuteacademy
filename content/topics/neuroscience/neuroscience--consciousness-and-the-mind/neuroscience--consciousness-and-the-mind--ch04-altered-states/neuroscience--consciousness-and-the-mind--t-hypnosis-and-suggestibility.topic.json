  "story": {
    "hook": {
      "text": "A hypnotized patient undergoes surgery without anesthesia, reports no pain, and shows no stress response on any physiological.",
      "visual": "🩺"
    },
    "buildup": {
      "text": "Hypnosis is focused attention plus heightened suggestibility: the subject responds to suggestions as if they were real events.",
      "visual": "🔮"
    },
    "discovery": {
      "text": "Brain scans show hypnosis reduces activity in the anterior cingulate cortex, weakening the conflict-monitoring system normally.",
      "visual": "📉"
    },
    "twist": {
      "text": "Hypnotic suggestions can alter perception itself.",
      "visual": "🎨"
    },
    "climax": {
      "text": "About 15 percent of people are highly hypnotizable.",
      "visual": "🧠"
    },
    "punchline": {
      "text": "Hypnosis does not shut the brain down.",
      "visual": "🌀"
    }
  },
  "quiz": {
    "question": "What brain change occurs during hypnosis?",
    "options": [
      "Reduced activity in the anterior cingulate cortex",
      "Increased activity in the motor cortex",
      "Complete shutdown of the prefrontal cortex"
    ],
    "correct": 0
  },
