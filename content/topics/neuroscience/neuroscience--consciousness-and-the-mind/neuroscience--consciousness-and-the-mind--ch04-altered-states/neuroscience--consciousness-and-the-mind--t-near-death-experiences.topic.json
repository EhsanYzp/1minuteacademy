  "story": {
    "hook": {
      "text": "A cardiac arrest patient is clinically dead for three minutes.",
      "visual": "💫"
    },
    "buildup": {
      "text": "Near-death experiences, or NDEs, are reported by roughly 10 to 20 percent of cardiac arrest survivors and share remarkably.",
      "visual": "🔦"
    },
    "discovery": {
      "text": "Common elements include a feeling of peace, seeing a bright light, encountering deceased relatives, and a life review plays like.",
      "visual": "🎞️"
    },
    "twist": {
      "text": "Rat studies show a surge of synchronized gamma waves 30 seconds after cardiac arrest, suggesting one final burst of activity.",
      "visual": "📊"
    },
    "climax": {
      "text": "Whether NDEs reflect genuine transcendence or a dying brain's last electrochemical storm remains one of the deepest unsolved.",
      "visual": "❓"
    },
    "punchline": {
      "text": "The brain may produce its most vivid experience at the moment it shuts down.",
      "visual": "🌅"
    }
  },
  "quiz": {
    "question": "What neural event occurs shortly after cardiac arrest in rat studies?",
    "options": [
      "A surge of synchronized gamma waves",
      "Complete cessation of all brain activity",
      "A massive release of melatonin"
    ],
    "correct": 0
  },
