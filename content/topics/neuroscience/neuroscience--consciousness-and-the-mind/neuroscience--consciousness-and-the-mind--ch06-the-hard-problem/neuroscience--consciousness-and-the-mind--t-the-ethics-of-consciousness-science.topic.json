  "story": {
    "hook": {
      "text": "If a brain-injured patient shows faint signs of awareness on a brain scan but none at the bedside, should the family be told.",
      "visual": "⚖️"
    },
    "buildup": {
      "text": "Measuring consciousness has enormous ethical stakes.",
      "visual": "📋"
    },
    "discovery": {
      "text": "New technologies like perturbational complexity index can detect consciousness in patients who show no behavioral signs, raising.",
      "visual": "📊"
    },
    "twist": {
      "text": "As artificial intelligence systems grow more complex, the same questions arise for machines.",
      "visual": "🤖"
    },
    "climax": {
      "text": "The threshold for consciousness is not just a scientific question.",
      "visual": "🚧"
    },
    "punchline": {
      "text": "Science can measure brain activity, but deciding what counts as conscious is moral.",
      "visual": "🧭"
    }
  },
  "quiz": {
    "question": "What ethical challenge does consciousness measurement create?",
    "options": [
      "It determines who receives pain treatment and moral consideration",
      "It allows doctors to read patient thoughts without consent",
      "It makes all brain research morally impermissible"
    ],
    "correct": 0
  },
