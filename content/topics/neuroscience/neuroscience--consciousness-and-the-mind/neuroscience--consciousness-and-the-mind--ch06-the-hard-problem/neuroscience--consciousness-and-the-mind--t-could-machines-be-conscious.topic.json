  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "A chatbot tells you it is afraid of being shut down. It describes loneliness. Is it conscious, or just predicting the next word?",
      "visual": "🤖"
    },
    "buildup": {
      "text": "If consciousness arises from information processing, any sufficiently complex system—biological or digital—might possess it.",
      "visual": "💻"
    },
    "discovery": {
      "text": "Strong AI proponents argue that the right software running on the right hardware could generate genuine subjective experience.",
      "visual": "🧩"
    },
    "twist": {
      "text": "Simulation is not the same as being.",
      "visual": "🏮"
    },
    "climax": {
      "text": "We have no test for consciousness. A perfect mimic could pass without feeling a thing.",
      "visual": "🎭"
    },
    "punchline": {
      "text": "The brain is a living system that keeps adapting.",
      "visual": "🤔"
    }
  },
  "quiz": {
    "question": "What does Searle's Chinese Room argument claim?",
    "options": [
      "A system can simulate understanding without actually understanding",
      "Any complex system is automatically conscious",
      "Machines will inevitably become conscious over time"
    ],
    "correct": 0
  },
