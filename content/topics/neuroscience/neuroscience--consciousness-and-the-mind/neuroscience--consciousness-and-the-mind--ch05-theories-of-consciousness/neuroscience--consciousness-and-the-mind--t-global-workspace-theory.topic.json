  "story": {
    "hook": {
      "text": "Imagine your brain as a dark theater. Many actors perform on stage, but only the one in the spotlight is visible to the audience.",
      "visual": "🎭"
    },
    "buildup": {
      "text": "Global Workspace Theory says consciousness is like a spotlight that broadcasts selected information across the entire brain.",
      "visual": "🔦"
    },
    "discovery": {
      "text": "Unconscious processes compete for access to the global workspace. The winner gets broadcast widely, becoming conscious experience.",
      "visual": "📡"
    },
    "twist": {
      "text": "This explains why you can only be conscious of one thing at a time: the spotlight is narrow, and only one performer fits in it.",
      "visual": "🎯"
    },
    "climax": {
      "text": "Global Workspace Theory matters because understanding the mechanism changes treatment, learning, and behavior.",
      "visual": "🌐"
    },
    "punchline": {
      "text": "Consciousness might be the brain's broadcasting system.",
      "visual": "📺"
    }
  },
  "quiz": {
    "question": "What does Global Workspace Theory compare consciousness to?",
    "options": [
      "A spotlight that broadcasts information brain-wide",
      "A computer hard drive storing data",
      "A single neuron that generates awareness"
    ],
    "correct": 0
  },
