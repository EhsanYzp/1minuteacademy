    "hook": {
      "text": "It requires quantum mechanics.",
      "visual": "⚛️"
    },
    "buildup": {
      "text": "The Penrose-Hameroff theory, called Orchestrated Objective Reduction or Orch OR, locates consciousness in quantum processes.",
      "visual": "🔬"
    },
    "discovery": {
      "text": "Microtubules form the internal scaffolding of every cell.",
      "visual": "🧬"
    },
    "twist": {
      "text": "Orchestrated Objective Reduction shows that brain function is more adaptive and surprising than it seems.",
      "visual": "🌡️"
    },
    "climax": {
      "text": "Recent experiments have found evidence of quantum effects lasting longer than expected in biological systems, reopening a debate.",
      "visual": "🔄"
    },
    "punchline": {
      "text": "It is woven into the quantum fabric of reality itself.",
      "visual": "🌌"
    }
  },
  "quiz": {
    "question": "Where does the Orch OR theory locate the quantum processes behind consciousness?",
    "options": [
      "Inside microtubules within neurons",
      "In the synaptic gaps between neurons",
      "In the electrical fields surrounding the brain"
    ],
