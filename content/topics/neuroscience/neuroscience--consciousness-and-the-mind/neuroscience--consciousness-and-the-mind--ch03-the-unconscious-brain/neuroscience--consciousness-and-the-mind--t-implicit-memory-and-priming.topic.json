  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "But hand them a puzzle they solved yesterday and they solve it faster.",
      "visual": "🧩"
    },
    "buildup": {
      "text": "Implicit memory operates without conscious awareness.",
      "visual": "🚲"
    },
    "discovery": {
      "text": "Implicit Memory and Priming reveals the neural mechanism driving the effect.",
      "visual": "🎲"
    },
    "twist": {
      "text": "Reading the word yellow makes you faster at naming the color of a banana, even without consciously noticing the connection.",
      "visual": "🍌"
    },
    "climax": {
      "text": "Priming studies reveal that the unconscious brain builds and uses associations that the conscious mind never accesses or approves.",
      "visual": "🕸️"
    },
    "punchline": {
      "text": "You remember far more than you know you remember.",
      "visual": "🗄️"
    }
  },
  "quiz": {
    "question": "What is priming?",
    "options": [
      "Exposure to one stimulus influencing response to a later one unconsciously",
      "The conscious rehearsal of information for memorization",
      "The loss of memory due to brain damage"
    ],
    "correct": 0
  },
