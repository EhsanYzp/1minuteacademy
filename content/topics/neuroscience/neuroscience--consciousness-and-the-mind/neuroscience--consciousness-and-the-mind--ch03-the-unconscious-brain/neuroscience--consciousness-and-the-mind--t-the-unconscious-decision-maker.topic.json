  "story": {
    "hook": {
      "text": "The brain had decided six seconds earlier.",
      "visual": "⏱️"
    },
    "buildup": {
      "text": "Benjamin Libet's experiments showed that a readiness potential in the brain precedes the conscious awareness of deciding to move.",
      "visual": "📈"
    },
    "discovery": {
      "text": "The Unconscious Decision Maker reveals the neural mechanism driving the effect.",
      "visual": "🔮"
    },
    "twist": {
      "text": "If the brain decides before you consciously choose, is free will an illusion created after the fact?",
      "visual": "🎭"
    },
    "climax": {
      "text": "You may not start actions, but you can stop them.",
      "visual": "🛑"
    },
    "punchline": {
      "text": "Your brain makes the call. Your consciousness writes the press release.",
      "visual": "📰"
    }
  },
  "quiz": {
    "question": "What did Libet's experiments reveal?",
    "options": [
      "Brain activity precedes conscious awareness of a decision",
      "Conscious decisions happen instantly with no neural buildup",
      "Free will operates independently of brain activity"
    ],
    "correct": 0
  },
