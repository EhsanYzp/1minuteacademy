  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "You are flying over a mountain range. You realize you are dreaming. You fly toward the ocean instead.",
      "visual": "🦅"
    },
    "buildup": {
      "text": "In lucid dreaming, the sleeper becomes aware they are dreaming and can sometimes exert control over the dream narrative.",
      "visual": "🎬"
    },
    "discovery": {
      "text": "Brain scans show lucid dreams involve partial reactivation of the prefrontal cortex, the region responsible for self-awareness.",
      "visual": "🧠"
    },
    "twist": {
      "text": "Lucid dreamers can communicate with researchers by moving their eyes in pre-agreed patterns while still asleep and dreaming.",
      "visual": "👀"
    },
    "climax": {
      "text": "This proves consciousness is not binary during sleep. The brain can be asleep and awake at the same time, in different regions.",
      "visual": "🌓"
    },
    "punchline": {
      "text": "In lucid dreaming the body sleeps, the cortex dreams, and the prefrontal cortex watches.",
      "visual": "🎭"
    }
  },
  "quiz": {
    "question": "What brain region reactivates during lucid dreaming?",
    "options": [
      "The prefrontal cortex",
      "The cerebellum",
      "The brainstem"
    ],
    "correct": 0
  },
