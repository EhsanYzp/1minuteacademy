  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "Hold your nose and eat a jelly bean. You'll taste sweet but won't know the flavor. Smell makes the difference.",
      "visual": "🫘"
    },
    "buildup": {
      "text": "Flavor is a combination of taste, smell, texture, temperature, and even sound (think crunchy chips).",
      "visual": "🥔"
    },
    "discovery": {
      "text": "Retronasal olfaction carries aromas from your mouth up to your nose while chewing, creating flavor perception.",
      "visual": "🔄"
    },
    "twist": {
      "text": "About 80% of what you call taste is actually smell. A cold that blocks your nose destroys flavor.",
      "visual": "🤧"
    },
    "climax": {
      "text": "Wine experts use retronasal olfaction expertly, which is why they swirl, sniff, and slurp so dramatically.",
      "visual": "🍷"
    },
    "punchline": {
      "text": "Flavor isn't in the food.",
      "visual": "🧠"
    }
  },
  "quiz": {
    "question": "What percentage of flavor perception comes from smell?",
    "options": [
      "About 80%",
      "About 20%",
      "Less than 5%"
    ],
    "correct": 0
  },
