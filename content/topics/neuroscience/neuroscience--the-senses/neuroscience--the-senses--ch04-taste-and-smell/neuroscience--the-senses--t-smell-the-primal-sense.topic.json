  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "A whiff of sunscreen and suddenly you're eight years old at the beach. Smell is the most powerful memory trigger.",
      "visual": "🏖️"
    },
    "buildup": {
      "text": "Olfactory neurons in your nose have roughly 400 types of receptors, each binding different odor molecules.",
      "visual": "👃"
    },
    "discovery": {
      "text": "Smell signals bypass the thalamus and go directly to the olfactory cortex and limbic system, the emotional brain.",
      "visual": "🧠"
    },
    "twist": {
      "text": "This direct connection to the hippocampus and amygdala explains why smells trigger such vivid emotional memories.",
      "visual": "💭"
    },
    "climax": {
      "text": "Humans can distinguish over one trillion different odor combinations, far more than previously believed.",
      "visual": "🔢"
    },
    "punchline": {
      "text": "Smell is the only sense with a direct line to your emotional memory centers.",
      "visual": "🎯"
    }
  },
  "quiz": {
    "question": "Why do smells trigger vivid emotional memories?",
    "options": [
      "Smell signals go directly to the limbic system",
      "Smells are processed in the cerebellum",
      "Odors activate the motor cortex"
    ],
    "correct": 0
  },
