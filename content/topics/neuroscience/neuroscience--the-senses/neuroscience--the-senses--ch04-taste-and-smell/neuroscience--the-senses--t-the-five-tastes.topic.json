  "story": {
    "hook": {
      "text": "Sweet, sour, salty, bitter, and umami. Every flavor you've ever tasted is a combination of just these five.",
      "visual": "👅"
    },
    "buildup": {
      "text": "Taste buds on your tongue contain receptor cells that detect molecules dissolved in saliva.",
      "visual": "🔬"
    },
    "discovery": {
      "text": "Sweet signals calories. Salty signals minerals. Bitter signals potential poison. Each taste evolved to guide nutrition.",
      "visual": "🍽️"
    },
    "twist": {
      "text": "Umami, the taste of savory richness, was only officially recognized in 2002 despite being proposed in 1908.",
      "visual": "🍜"
    },
    "climax": {
      "text": "The tongue map showing taste zones is a myth. All five tastes are detected across the entire tongue.",
      "visual": "🗺️"
    },
    "punchline": {
      "text": "Five tastes. Infinite combinations. Your tongue is simpler than you thought.",
      "visual": "🎯"
    }
  },
  "quiz": {
    "question": "Is the tongue map showing specific taste zones accurate?",
    "options": [
      "No, all tastes are detected across the entire tongue",
      "Yes, sweet is only at the tip",
      "Yes, bitter is only at the back"
    ],
    "correct": 0
  },
