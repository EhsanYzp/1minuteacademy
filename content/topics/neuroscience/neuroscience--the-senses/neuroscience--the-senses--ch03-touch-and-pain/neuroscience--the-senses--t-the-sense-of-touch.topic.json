  "is_free": true,
  "published": true,
  "story": {
    "hook": {
      "text": "Your fingertips can detect a vibration as small as 0.01 millimeters. That sensitivity rivals laboratory instruments.",
      "visual": "🤏"
    },
    "buildup": {
      "text": "Four types of mechanoreceptors in your skin respond to pressure, vibration, stretch, and texture.",
      "visual": "✋"
    },
    "discovery": {
      "text": "Your fingertips and lips have the densest receptor concentration, which is why they're so sensitive.",
      "visual": "👄"
    },
    "twist": {
      "text": "The somatosensory cortex maps your body, but the map is distorted. Hands and face take up disproportionate space.",
      "visual": "🗺️"
    },
    "climax": {
      "text": "The sensory homunculus, a drawing of the body based on cortical representation, has enormous hands and lips.",
      "visual": "🤡"
    },
    "punchline": {
      "text": "Sensitivity decides the proportions.",
      "visual": "📏"
    }
  },
  "quiz": {
    "question": "Why do fingertips have more cortical representation than the back?",
    "options": [
      "They have a much higher density of touch receptors",
      "They are physically larger",
      "They have more blood flow"
    ],
    "correct": 0
  },
