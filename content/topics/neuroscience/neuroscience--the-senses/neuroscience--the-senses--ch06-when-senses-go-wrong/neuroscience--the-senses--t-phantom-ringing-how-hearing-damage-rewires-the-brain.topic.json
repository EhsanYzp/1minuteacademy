  "story": {
    "hook": {
      "text": "Millions of people hear a relentless ringing that does not exist in the outside world. Their brains invented it.",
      "visual": "🔔"
    },
    "buildup": {
      "text": "When cochlear hair cells die from loud noise or aging, the auditory cortex loses its normal input from those frequencies.",
      "visual": "📉"
    },
    "discovery": {
      "text": "Instead of staying silent, the deprived neurons become hyperactive. They fire spontaneously, creating a phantom tone.",
      "visual": "⚡"
    },
    "twist": {
      "text": "This is maladaptive plasticity. The brain's ability to reorganize, normally a strength, here becomes the source of suffering.",
      "visual": "🔄"
    },
    "climax": {
      "text": "Neuroimaging shows that chronic tinnitus involves not just auditory areas but also limbic regions tied to stress and emotion.",
      "visual": "🧠"
    },
    "punchline": {
      "text": "Sometimes rewiring creates noise instead of silence.",
      "visual": "🔊"
    }
  },
  "quiz": {
    "question": "What is the primary neural mechanism behind chronic tinnitus?",
    "options": [
      "Maladaptive plasticity causing hyperactivity in deprived auditory neurons",
      "Excess fluid in the inner ear",
      "Overgrowth of hair cells in the cochlea"
    ],
    "correct": 0
  },
