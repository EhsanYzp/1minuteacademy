  "story": {
    "hook": {
      "text": "Blind people can learn to see with their tongue. A camera feeds images as tingling patterns on a tongue display.",
      "visual": "👅"
    },
    "buildup": {
      "text": "Sensory substitution devices convert information from one sense into signals another sense can interpret.",
      "visual": "🔄"
    },
    "discovery": {
      "text": "After training, users navigate rooms, catch balls, and read signs using tongue-based vision.",
      "visual": "🏀"
    },
    "twist": {
      "text": "Brain scans show that the visual cortex activates during tongue-vision, repurposing itself for the new input.",
      "visual": "🧠"
    },
    "climax": {
      "text": "This proves the brain doesn't care which sense delivers information. It will process whatever arrives.",
      "visual": "📡"
    },
    "punchline": {
      "text": "The brain isn't locked to specific senses. Give it data and it will figure out what to do.",
      "visual": "🔓"
    }
  },
  "quiz": {
    "question": "What brain region activates during tongue-based vision?",
    "options": [
      "The visual cortex",
      "The gustatory cortex",
      "The motor cortex"
    ],
    "correct": 0
  },
