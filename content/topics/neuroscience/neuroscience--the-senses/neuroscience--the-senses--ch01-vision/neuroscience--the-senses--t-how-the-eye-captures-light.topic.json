  "chapter_id": "neuroscience--the-senses--ch01-vision",
  "title": "How the Eye Captures Light",
  "emoji": "👁️",
  "color": "#A855F7",
  "description": "A quick, practical guide to How the Eye Captures Light.",
  "is_free": true,
  "published": true,
  "story": {
    "hook": {
      "text": "Your eyes are inside-out brains. The retina is actually a piece of neural tissue that grew outward from the brain.",
      "visual": "👁️"
    },
    "buildup": {
      "text": "Light enters through the cornea, is focused by the lens, and hits 130 million photoreceptor cells in the retina.",
      "visual": "🔬"
    },
    "discovery": {
      "text": "Rods detect dim light and movement. Cones detect color and detail in bright conditions.",
      "visual": "🎨"
    },
    "twist": {
      "text": "Your fovea, the center of sharp vision, has only cones and covers just 1% of the retina but uses 50% of the visual cortex.",
      "visual": "🎯"
    },
    "climax": {
      "text": "The image on your retina is upside down and backwards. Your brain flips it right-side up automatically.",
      "visual": "🙃"
    },
    "punchline": {
      "text": "Your eyes are cameras. Your brain is the photographer deciding what you actually see.",
      "visual": "📸"
    }
  },
  "quiz": {
    "question": "What do cone cells in the retina detect?",
    "options": [
      "Color and fine detail",
      "Only dim light",
      "Sound vibrations"
    ],
    "correct": 0
  },
