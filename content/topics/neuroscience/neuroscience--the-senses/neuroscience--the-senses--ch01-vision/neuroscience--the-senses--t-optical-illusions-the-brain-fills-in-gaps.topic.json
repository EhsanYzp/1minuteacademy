  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "Stare at the famous spinning dancer. Half the people see her spinning clockwise. Half see counterclockwise.",
      "visual": "💃"
    },
    "buildup": {
      "text": "Optical illusions reveal that perception isn't passive recording. The brain actively interprets and constructs what you see.",
      "visual": "🔮"
    },
    "discovery": {
      "text": "Your brain fills in your blind spot every second. You have one in each eye and never notice it.",
      "visual": "⚫"
    },
    "twist": {
      "text": "Change blindness shows that large objects can appear or vanish from a scene without you noticing.",
      "visual": "🫥"
    },
    "climax": {
      "text": "These aren't bugs in your perception. They're features that let you process a chaotic world efficiently.",
      "visual": "⚡"
    },
    "punchline": {
      "text": "You don't see reality. You see a model your brain built and decided to call reality.",
      "visual": "🧩"
    }
  },
  "quiz": {
    "question": "What is change blindness?",
    "options": [
      "Failing to notice large changes in a visual scene",
      "Being unable to see colors",
      "Blindness caused by aging"
    ],
    "correct": 0
  },
