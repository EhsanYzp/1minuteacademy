  "story": {
    "hook": {
      "text": "Motion Perception and the MT Area: the brain looks stable, but the mechanism underneath is anything but simple.",
      "visual": "☕"
    },
    "buildup": {
      "text": "Area MT, also called V5, is a specialized region in the visual cortex dedicated entirely to detecting movement.",
      "visual": "🧠"
    },
    "discovery": {
      "text": "MT neurons respond to the direction and speed of moving objects by assembling motion from rapidly changing retinal images.",
      "visual": "🎬"
    },
    "twist": {
      "text": "Damage to MT causes akinetopsia, or motion blindness. Patients see the world as a series of still photographs.",
      "visual": "📷"
    },
    "climax": {
      "text": "One famous patient could not cross a street because cars appeared to teleport from one position to another.",
      "visual": "🚗"
    },
    "punchline": {
      "text": "The brain is a living system that keeps adapting.",
      "visual": "🎞️"
    }
  },
  "quiz": {
    "question": "What condition results from damage to the MT/V5 area?",
    "options": [
      "Akinetopsia, the inability to perceive motion",
      "Complete blindness in both eyes",
      "Loss of color vision"
    ],
    "correct": 0
  },
