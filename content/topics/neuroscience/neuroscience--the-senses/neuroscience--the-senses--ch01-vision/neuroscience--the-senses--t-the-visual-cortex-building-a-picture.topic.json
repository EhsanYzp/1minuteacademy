  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "Your retina sends raw data. The visual cortex builds it into the rich, detailed scene you experience.",
      "visual": "🖼️"
    },
    "buildup": {
      "text": "V1, the primary visual cortex, detects edges, lines, and basic shapes using orientation-selective neurons.",
      "visual": "📐"
    },
    "discovery": {
      "text": "Higher visual areas specialize: V4 processes color, V5 handles motion, and the fusiform face area recognizes faces.",
      "visual": "👤"
    },
    "twist": {
      "text": "Hubel and Wiesel won the Nobel Prize for showing that visual neurons respond to specific orientations of lines.",
      "visual": "🏆"
    },
    "climax": {
      "text": "Without V5, you could see objects but not their movement. Pouring tea would look like a frozen photograph.",
      "visual": "🍵"
    },
    "punchline": {
      "text": "You don't see with your eyes.",
      "visual": "🎻"
    }
  },
  "quiz": {
    "question": "What does area V5 in the visual cortex process?",
    "options": [
      "Motion",
      "Color",
      "Faces"
    ],
    "correct": 0
  },
