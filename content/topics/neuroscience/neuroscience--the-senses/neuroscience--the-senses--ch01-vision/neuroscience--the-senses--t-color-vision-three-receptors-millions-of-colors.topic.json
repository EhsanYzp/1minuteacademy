  "description": "Learn Color Vision: Three Receptors, Millions of Colors in one minute.",
  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "You see millions of colors. Yet you have only three types of cone cells: red, green, and blue.",
      "visual": "🌈"
    },
    "buildup": {
      "text": "Each cone type responds to a range of wavelengths. Your brain mixes their signals to create every color you perceive.",
      "visual": "🎨"
    },
    "discovery": {
      "text": "Color is not a property of light itself. It's a label your brain assigns to different wavelengths.",
      "visual": "🏷️"
    },
    "twist": {
      "text": "About 8% of men are color blind, usually unable to distinguish red from green due to a cone deficiency.",
      "visual": "🔴"
    },
    "climax": {
      "text": "Mantis shrimp have 16 types of color receptors. They see colors humans cannot even imagine.",
      "visual": "🦐"
    },
    "punchline": {
      "text": "Color isn't in the world. It's in your brain's interpretation of the world.",
      "visual": "🧠"
    }
  },
  "quiz": {
    "question": "How many types of cone cells do humans have?",
    "options": [
      "Three",
      "Seven",
      "One"
    ],
    "correct": 0
  },
