  "story": {
    "hook": {
      "text": "A teenager drives safely when alone. The passengers did not touch the wheel.",
      "visual": "🚗"
    },
    "buildup": {
      "text": "During adolescence, the brain's social processing networks become hypersensitive to peer evaluation, acceptance, and rejection.",
      "visual": "👥"
    },
    "discovery": {
      "text": "Brain imaging shows the presence of peers activates the ventral striatum, the reward center, making risky choices feel more.",
      "visual": "🧠"
    },
    "twist": {
      "text": "Peer rejection activates the same brain regions as physical pain: the dorsal anterior cingulate cortex and the anterior insula.",
      "visual": "💔"
    },
    "climax": {
      "text": "This neural sensitivity to peers is an evolutionary feature pushed adolescents to form alliances essential for survival outside.",
      "visual": "🏕️"
    },
    "punchline": {
      "text": "Teenagers do not care about peer approval because they are shallow.",
      "visual": "🛡️"
    }
  },
  "quiz": {
    "question": "What happens in the teenage brain when peers are present?",
    "options": [
      "The reward center activates, making risks feel more rewarding",
      "The prefrontal cortex becomes more active, improving decisions",
      "The brain shuts down emotional processing"
    ],
    "correct": 0
  },
