  "story": {
    "hook": {
      "text": "Their brain's clock has physically shifted.",
      "visual": "🕛"
    },
    "buildup": {
      "text": "Sleep and the Adolescent Clock sets up the neural system, the mechanism, and why it matters.",
      "visual": "🌙"
    },
    "discovery": {
      "text": "This chronotype shift is driven by changes in the suprachiasmatic nucleus and hormonal influences on melatonin timing.",
      "visual": "⏰"
    },
    "twist": {
      "text": "Most schools start at 7:30 or 8:00 AM, forcing teenagers to wake during their biological night and chronically losing sleep.",
      "visual": "😴"
    },
    "climax": {
      "text": "Sleep-deprived adolescents show impaired memory, worse emotional regulation, and higher rates of depression.",
      "visual": "📉"
    },
    "punchline": {
      "text": "The teenage brain is not lazy about sleep.",
      "visual": "🏫"
    }
  },
  "quiz": {
    "question": "What happens to the circadian rhythm during puberty?",
    "options": [
      "It shifts later by one to three hours",
      "It shifts earlier by two hours",
      "It remains the same as in childhood"
    ],
    "correct": 0
  },
