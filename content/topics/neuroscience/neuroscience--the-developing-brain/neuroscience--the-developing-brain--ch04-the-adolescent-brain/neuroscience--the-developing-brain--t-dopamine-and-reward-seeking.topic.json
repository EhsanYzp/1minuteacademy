  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "The same reward literally feels better to them.",
      "visual": "🎰"
    },
    "buildup": {
      "text": "During adolescence, the dopamine system is hypersensitive.",
      "visual": "🚀"
    },
    "discovery": {
      "text": "This heightened dopamine response evolved to motivate young humans to explore, take social risks, and separate from parents.",
      "visual": "🌍"
    },
    "twist": {
      "text": "Substances hijack an already amplified reward system.",
      "visual": "⚠️"
    },
    "climax": {
      "text": "Dopamine and Reward-Seeking matters because understanding the mechanism changes treatment, learning, and behavior.",
      "visual": "📊"
    },
    "punchline": {
      "text": "The brain is a living system that keeps adapting.",
      "visual": "🎯"
    }
  },
  "quiz": {
    "question": "Why are adolescents more vulnerable to addiction?",
    "options": [
      "Their dopamine system is hypersensitive while impulse control is immature",
      "Their brains produce less dopamine than adults",
      "They have fewer neurons in the reward system"
    ],
    "correct": 0
  },
