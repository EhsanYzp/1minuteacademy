  "description": "A tiny lesson with a big payoff: The Synapse Explosion.",
  "is_free": true,
  "published": true,
  "story": {
    "hook": {
      "text": "A newborn baby's brain forms 700 to 1,000 new synaptic connections every single second during the first few years of life.",
      "visual": "💥"
    },
    "buildup": {
      "text": "This synaptogenesis is driven by sensory experience. Every sight, sound, and touch triggers the formation of new neural pathways.",
      "visual": "🌈"
    },
    "discovery": {
      "text": "By age two, a toddler has roughly twice as many synapses as an adult, producing a brain that is massively over-connected.",
      "visual": "🕸️"
    },
    "twist": {
      "text": "This overproduction is intentional.",
      "visual": "🌳"
    },
    "climax": {
      "text": "The pruning process follows a simple rule: use it or lose it. Synapses that fire frequently survive; inactive ones are eliminated.",
      "visual": "✂️"
    },
    "punchline": {
      "text": "The infant brain is not under-developed.",
      "visual": "🌍"
    }
  },
  "quiz": {
    "question": "How many new synapses does an infant brain form per second?",
    "options": [
      "700 to 1,000",
      "About 10",
      "Over 1 million"
    ],
    "correct": 0
  },
