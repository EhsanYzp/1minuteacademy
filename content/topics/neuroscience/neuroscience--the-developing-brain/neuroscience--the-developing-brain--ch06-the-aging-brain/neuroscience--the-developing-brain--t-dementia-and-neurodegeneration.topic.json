  "story": {
    "hook": {
      "text": "Dementia has erased decades of expertise in a few years.",
      "visual": "🌫️"
    },
    "buildup": {
      "text": "Dementia is not normal aging. It is caused by diseases like Alzheimer's that destroys neurons through toxic protein accumulation.",
      "visual": "🧬"
    },
    "discovery": {
      "text": "In Alzheimer's, amyloid plaques and tau tangles accumulate between and inside neurons, disrupting communication and killing cells.",
      "visual": "🕸️"
    },
    "twist": {
      "text": "Neurodegeneration begins 15 to 20 years before symptoms appear.",
      "visual": "⏰"
    },
    "climax": {
      "text": "Dementia and Neurodegeneration matters because understanding the mechanism changes treatment, learning, and behavior.",
      "visual": "🛡️"
    },
    "punchline": {
      "text": "Dementia is not inevitable. Understanding the developing brain may help prevent it.",
      "visual": "🔬"
    }
  },
  "quiz": {
    "question": "How long before symptoms does Alzheimer's neurodegeneration typically begin?",
    "options": [
      "15 to 20 years",
      "A few months",
      "About 1 year"
    ],
    "correct": 0
  },
