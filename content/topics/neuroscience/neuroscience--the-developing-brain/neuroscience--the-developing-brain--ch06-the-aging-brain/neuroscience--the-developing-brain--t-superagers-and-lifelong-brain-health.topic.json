  "story": {
    "hook": {
      "text": "Some 80-year-olds perform and 50-year-olds on memory tests. Scientists call them superagers.",
      "visual": "🦸"
    },
    "buildup": {
      "text": "Superagers maintain thicker cortices, especially in the anterior cingulate cortex and prefrontal regions normally thin with age.",
      "visual": "🧠"
    },
    "discovery": {
      "text": "They share lifestyle traits: regular vigorous exercise, strong social connections, intellectual curiosity, and purposeful living.",
      "visual": "🏋️"
    },
    "twist": {
      "text": "Superagers do not avoid hard things.",
      "visual": "😤"
    },
    "climax": {
      "text": "The common thread is not genetics alone.",
      "visual": "📈"
    },
    "punchline": {
      "text": "The secret to a young brain is not rest.",
      "visual": "🏆"
    }
  },
  "quiz": {
    "question": "What trait do superagers commonly share?",
    "options": [
      "They regularly engage in mentally demanding tasks",
      "They avoid all forms of stress",
      "They sleep more than 12 hours per day"
    ],
    "correct": 0
  },
