  "story": {
    "hook": {
      "text": "Your second brain lives in your belly.",
      "visual": "🦠"
    },
    "buildup": {
      "text": "The microbiome communicates with the brain through the vagus nerve, immune signaling molecules, and short-chain fatty acids cross.",
      "visual": "🔗"
    },
    "discovery": {
      "text": "As people age, gut microbiome diversity declines.",
      "visual": "📉"
    },
    "twist": {
      "text": "Transferring gut bacteria from young mice into old mice improved memory and reduced brain inflammation, suggesting the microbiome.",
      "visual": "🐭"
    },
    "climax": {
      "text": "Diets rich in fiber, fermented foods, and polyphenols support microbiome diversity and slow cognitive decline in aging adults.",
      "visual": "🥦"
    },
    "punchline": {
      "text": "Feed your bacteria well and they return the favor to your neurons.",
      "visual": "🤝"
    }
  },
  "quiz": {
    "question": "How does the gut microbiome communicate with the brain?",
    "options": [
      "Through the vagus nerve, immune signals, and short-chain fatty acids",
      "Only through direct neural connections in the spinal cord",
      "It does not communicate with the brain at all"
    ],
    "correct": 0
  },
