  "story": {
    "hook": {
      "text": "You walk into a room and forget why you are there. At 25, you laugh it off. At 65, you worry it means something worse.",
      "visual": "🚪"
    },
    "buildup": {
      "text": "Normal Cognitive Aging sets up the neural system, the mechanism, and why it matters.",
      "visual": "🐢"
    },
    "discovery": {
      "text": "Normal Cognitive Aging reveals the neural mechanism driving the effect.",
      "visual": "📉"
    },
    "twist": {
      "text": "But vocabulary, general knowledge, and emotional regulation actually improve with age. The brain trades speed for wisdom.",
      "visual": "📚"
    },
    "climax": {
      "text": "Normal aging is not dementia. The vast majority of older adults retain functional cognition well into their eighties and beyond.",
      "visual": "💪"
    },
    "punchline": {
      "text": "The aging brain is slower but deeper.",
      "visual": "🦉"
    }
  },
  "quiz": {
    "question": "Which cognitive ability typically improves with normal aging?",
    "options": [
      "Vocabulary and general knowledge",
      "Processing speed",
      "Working memory capacity"
    ],
    "correct": 0
  },
