    "hook": {
      "text": "London taxi drivers who memorize 25,000 streets develop larger posterior hippocampi than bus drivers on fixed routes.",
      "visual": "🚕"
    },
    "buildup": {
      "text": "The adult brain retains significant plasticity.",
      "visual": "🌿"
    },
    "discovery": {
      "text": "Lifelong Learning and Adult Plasticity reveals the neural mechanism driving the effect.",
      "visual": "🧬"
    },
    "twist": {
      "text": "Passive consumption does not trigger plasticity.",
      "visual": "❌"
    },
    "climax": {
      "text": "Lifelong Learning and Adult Plasticity matters because the mechanism changes how we understand the brain.",
      "visual": "🎻"
    },
    "punchline": {
      "text": "The adult brain is not a finished product.",
      "visual": "🔄"
    }
  },
  "quiz": {
    "question": "What structural brain change was found in London taxi drivers?",
    "options": [
      "Larger posterior hippocampi from memorizing city streets",
      "Smaller amygdalae from reduced stress",
      "Thicker motor cortex from driving"
