  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "A 30-minute run does not just strengthen your legs. It triggers a cascade of molecular events that physically remodel your brain.",
      "visual": "🏃"
    },
    "buildup": {
      "text": "Aerobic exercise increases blood flow to the brain, delivering more oxygen and glucose to fuel neural activity.",
      "visual": "🩸"
    },
    "discovery": {
      "text": "Exercise triggers the release of BDNF, brain-derived neurotrophic factor promotes the growth of new neurons in the hippocampus.",
      "visual": "🌱"
    },
    "twist": {
      "text": "Regular exercisers have larger hippocampal volumes, better memory performance, and slower rates of age-related cognitive decline.",
      "visual": "📏"
    },
    "climax": {
      "text": "Even starting exercise in middle age produces measurable brain benefits.",
      "visual": "📈"
    },
    "punchline": {
      "text": "The best brain supplement is not a pill. It is a pair of running shoes.",
      "visual": "👟"
    }
  },
  "quiz": {
    "question": "What does exercise trigger in the brain?",
    "options": [
      "Release of BDNF, promoting new neuron growth",
      "Immediate shrinkage of the amygdala",
      "Permanent closure of all critical periods"
    ],
    "correct": 0
  },
