  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "A child who starts piano lessons at age four will likely develop absolute pitch. Start at age fourteen and that window has closed.",
      "visual": "🎹"
    },
    "buildup": {
      "text": "Sensitive periods are time windows when the brain is especially responsive to input, making learning faster and more permanent.",
      "visual": "📖"
    },
    "discovery": {
      "text": "Learning is still possible later but requires much more effort.",
      "visual": "📉"
    },
    "twist": {
      "text": "Mathematics has sensitive periods too.",
      "visual": "🔢"
    },
    "climax": {
      "text": "Stress and deprivation can shrink sensitive periods, while enrichment and positive social interaction can extend them.",
      "visual": "⏳"
    },
    "punchline": {
      "text": "The brain has windows of opportunity for every skill.",
      "visual": "🪟"
    }
  },
  "quiz": {
    "question": "How do sensitive periods differ from critical periods?",
    "options": [
      "Sensitive periods fade gradually rather than closing sharply",
      "Sensitive periods only affect motor skills",
      "Sensitive periods occur only in adulthood"
    ],
    "correct": 0
  },
