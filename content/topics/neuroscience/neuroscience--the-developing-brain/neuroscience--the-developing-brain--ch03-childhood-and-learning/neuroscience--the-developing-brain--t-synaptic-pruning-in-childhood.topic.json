  "is_free": true,
  "published": true,
  "story": {
    "hook": {
      "text": "It is getting smaller and smarter at the same time.",
      "visual": "✂️"
    },
    "buildup": {
      "text": "Pruning follows the use-it-or-lose-it principle.",
      "visual": "🏷️"
    },
    "discovery": {
      "text": "Microglia, the immune cells of the brain, physically engulf and digest unwanted synapses in a process guided by activity patterns.",
      "visual": "🦠"
    },
    "twist": {
      "text": "Excessive pruning is linked to schizophrenia, while insufficient pruning is linked to autism, suggesting both extremes cause.",
      "visual": "⚖️"
    },
    "climax": {
      "text": "The pruning schedule varies by brain region.",
      "visual": "📅"
    },
    "punchline": {
      "text": "A child's brain is not getting worse as it loses synapses.",
      "visual": "📝"
    }
  },
  "quiz": {
    "question": "What role do microglia play in synaptic pruning?",
    "options": [
      "They engulf and digest unwanted synapses",
      "They create new synapses to replace old ones",
      "They protect all synapses from elimination"
    ],
    "correct": 0
  },
