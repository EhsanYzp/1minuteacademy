  "title": "Sensitive Periods vs. Critical Periods",
  "emoji": "🔄",
  "color": "#7E22CE",
  "description": "Learn Sensitive Periods vs. Critical Periods in one minute.",
  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "Not every developmental window slams shut. Some close gently, like a door slowly swinging on its hinges.",
      "visual": "🚪"
    },
    "buildup": {
      "text": "Critical periods have a hard cutoff. Once they close, the circuit is locked and the missed experience cannot be recovered.",
      "visual": "🔒"
    },
    "discovery": {
      "text": "Sensitive periods are different.",
      "visual": "📉"
    },
    "twist": {
      "text": "Language acquisition has both.",
      "visual": "🗣️"
    },
    "climax": {
      "text": "Understanding the difference matters for education and therapy, because interventions during a sensitive period can still rewire.",
      "visual": "🎓"
    },
    "punchline": {
      "text": "Some brain windows slam. Others just get harder to push open.",
      "visual": "🪟"
    }
  },
  "quiz": {
    "question": "How does a sensitive period differ from a critical period?",
    "options": [
      "A sensitive period fades gradually while a critical period has a hard cutoff",
      "A sensitive period affects only motor skills",
      "A sensitive period occurs only in old age"
    ],
    "correct": 0
  },
