  "is_free": true,
  "published": true,
  "story": {
    "hook": {
      "text": "For most of the 20th century, scientists believed the adult brain was fixed, like concrete that had already set.",
      "visual": "🧱"
    },
    "buildup": {
      "text": "Injuries, strokes, and aging were thought to cause permanent damage because neurons could not regenerate.",
      "visual": "🚫"
    },
    "discovery": {
      "text": "Neuroplasticity is the brain's ability to reorganize itself by forming new neural connections throughout life.",
      "visual": "🔄"
    },
    "twist": {
      "text": "Even elderly brains can rewire. London taxi drivers who memorize city maps grow larger hippocampi over time.",
      "visual": "🚕"
    },
    "climax": {
      "text": "Plasticity is not a bonus feature. It is the fundamental operating principle of every brain, from birth to death.",
      "visual": "🧠"
    },
    "punchline": {
      "text": "Your brain was never concrete. It was always clay.",
      "visual": "🏺"
    }
  },
  "quiz": {
    "question": "What is neuroplasticity?",
    "options": [
      "The brain's ability to reorganize by forming new connections",
      "The brain's ability to grow larger every year",
      "The process of neurons hardening with age"
    ],
    "correct": 0
  },
