  "story": {
    "hook": {
      "text": "Textbooks used to say that you are born with all the neurons you will ever have. That turned out to be wrong.",
      "visual": "📚"
    },
    "buildup": {
      "text": "In the 1990s, researchers discovered that new neurons are born in the adult hippocampus, a region vital for memory.",
      "visual": "🌱"
    },
    "discovery": {
      "text": "Adult neurogenesis produces roughly 700 new hippocampal neurons per day, integrating them into existing memory circuits.",
      "visual": "🔢"
    },
    "twist": {
      "text": "Exercise dramatically boosts neurogenesis. Running doubles the production of new neurons in the hippocampus of mice.",
      "visual": "🏃"
    },
    "climax": {
      "text": "Chronic stress and depression suppress neurogenesis. Antidepressants may work partly by restoring new neuron production.",
      "visual": "💊"
    },
    "punchline": {
      "text": "You grow new brain cells every day. Whether they survive depends on how you live.",
      "visual": "🌿"
    }
  },
  "quiz": {
    "question": "Where does adult neurogenesis primarily occur?",
    "options": [
      "The hippocampus",
      "The cerebellum",
      "The brainstem"
    ],
    "correct": 0
  },
