  "story": {
    "hook": {
      "text": "Mental Rehearsal and Neural Change: the brain looks stable, but the mechanism underneath is anything but simple.",
      "visual": "🎹"
    },
    "buildup": {
      "text": "Mental rehearsal, or motor imagery, activates many of the same neural circuits used during actual physical movement.",
      "visual": "🧠"
    },
    "discovery": {
      "text": "Mental Rehearsal and Neural Change reveals the neural mechanism driving the effect.",
      "visual": "📊"
    },
    "twist": {
      "text": "The effect is not limited to music.",
      "visual": "🏅"
    },
    "climax": {
      "text": "Combined with physical practice, mental rehearsal accelerates skill acquisition by strengthening synaptic pathways during rest.",
      "visual": "🔗"
    },
    "punchline": {
      "text": "You do not always need to move to train your brain. Sometimes thinking is the workout.",
      "visual": "💭"
    }
  },
  "quiz": {
    "question": "What happens in the brain during mental rehearsal of a movement?",
    "options": [
      "Many of the same motor circuits activate as during real movement",
      "The brain shuts down motor regions to conserve energy",
      "Only visual cortex areas are engaged"
    ],
    "correct": 0
  },
