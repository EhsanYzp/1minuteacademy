  "story": {
    "hook": {
      "text": "Raise two groups of genetically identical rats in different cages and their brains will look surprisingly different.",
      "visual": "🐀"
    },
    "buildup": {
      "text": "Rats in enriched environments with toys, tunnels, and companions develop thicker cortices, more synapses, and better.",
      "visual": "🧩"
    },
    "discovery": {
      "text": "Rats in bare cages with no stimulation develop thinner cortices, fewer dendritic spines, and worse memory.",
      "visual": "📦"
    },
    "twist": {
      "text": "The effect is not limited to young brains. Even elderly rats show cortical thickening when moved to enriched environments.",
      "visual": "👴"
    },
    "climax": {
      "text": "Human studies confirm the pattern: children raised in stimulating homes show faster cognitive development and denser neural.",
      "visual": "🏠"
    },
    "punchline": {
      "text": "The brain does not grow in a vacuum. It grows into the shape of the world you give it.",
      "visual": "🌍"
    }
  },
  "quiz": {
    "question": "What happens to rat brains in enriched environments?",
    "options": [
      "They develop thicker cortices and more synapses",
      "They develop fewer neurons to conserve energy",
      "They show no measurable differences from control groups"
    ],
    "correct": 0
  },
