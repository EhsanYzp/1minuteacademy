  "is_free": false,
  "published": true,
  "story": {
    "hook": {
      "text": "Bilingual people do not just know two languages. Their brains are physically different from monolingual brains.",
      "visual": "🗣️"
    },
    "buildup": {
      "text": "Constantly switching between languages exercises the prefrontal cortex, the brain region responsible for executive control.",
      "visual": "🏋️"
    },
    "discovery": {
      "text": "Brain scans show bilinguals have denser gray matter in the left inferior parietal cortex, a region involved in language.",
      "visual": "🧠"
    },
    "twist": {
      "text": "The bilingual advantage extends beyond language.",
      "visual": "🎯"
    },
    "climax": {
      "text": "Lifelong bilingualism delays the onset of dementia symptoms by an average of four to five years compared to monolingualism.",
      "visual": "🛡️"
    },
    "punchline": {
      "text": "It physically fortifies your brain.",
      "visual": "🏰"
    }
  },
  "quiz": {
    "question": "How does bilingualism affect the brain?",
    "options": [
      "It increases gray matter density in language regions",
      "It reduces overall brain volume",
      "It has no measurable structural effect"
    ],
    "correct": 0
  },
