  "is_free": true,
  "published": true,
  "story": {
    "hook": {
      "text": "A stroke destroys part of the brain in minutes. Yet months later, many patients recover abilities that seemed permanently lost.",
      "visual": "🏥"
    },
    "buildup": {
      "text": "When a brain region dies, surrounding neurons begin sprouting new axonal branches toward the damaged area.",
      "visual": "🌱"
    },
    "discovery": {
      "text": "Surviving neurons take on the functions of dead ones through a process called cortical reorganization.",
      "visual": "🔄"
    },
    "twist": {
      "text": "Constraint-induced therapy forces patients to use their impaired limb, accelerating plasticity by driving massive neural.",
      "visual": "🦾"
    },
    "climax": {
      "text": "The critical window for recovery is the first three months, when the brain releases growth factors that promote rewiring.",
      "visual": "⏳"
    },
    "punchline": {
      "text": "The brain cannot resurrect dead neurons. But it can teach living ones to do their jobs.",
      "visual": "🎓"
    }
  },
  "quiz": {
    "question": "What is constraint-induced therapy?",
    "options": [
      "Forcing use of the impaired limb to drive neural reorganization",
      "Preventing all movement to let the brain rest",
      "Replacing dead neurons with stem cells"
    ],
    "correct": 0
  },
